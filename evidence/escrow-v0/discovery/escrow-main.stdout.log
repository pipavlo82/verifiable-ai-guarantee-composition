{"sha":"ce8c504f2ae4d9b389b53823fe16afec7fcf3bb3","node_id":"C_kwDOSejZmNoAKGNlOGM1MDRmMmFlNGQ5YjM4OWI1MzgyM2ZlMTZhZmVjN2ZjZjNiYjM","commit":{"author":{"name":"babyblueviper1","email":"contact@invinoveritas.dev","date":"2026-10-19T12:42:20Z"},"committer":{"name":"babyblueviper1","email":"contact@invinoveritas.dev","date":"2026-10-19T12:42:20Z"},"message":"examples: stdlib cold checker for the work-acceptance record log\n\nRecomputes log_root, the prev_root chain, Merkle roots and enrollment signatures\nfrom the published files, enforces append-only with present/declined final, and\nreports a per-key decline rate over closed records (NOT_MEASURED, never 0).","tree":{"sha":"a6542c9ec0f7521d438040781758e83680c8b4d7","url":"https://api.github.com/repos/babyblueviper1/invinoveritas/git/trees/a6542c9ec0f7521d438040781758e83680c8b4d7"},"url":"https://api.github.com/repos/babyblueviper1/invinoveritas/git/commits/ce8c504f2ae4d9b389b53823fe16afec7fcf3bb3","comment_count":0,"verification":{"verified":false,"reason":"bad_email","signature":"-----BEGIN PGP SIGNATURE-----\n\niQIzBAABCgAdFiEE1O9Mv55syIRNG9aQu93LoQXT7fgFAmrWECwACgkQu93LoQXT\n7fg6uA//dW1i1stt2kUSTZKaN6SSplbkW7KN11UveucTKvnIZ2bUiJ63Uy3EXx0F\nv3mHvXRp9dZ0/X3TSMTHl5fhLiGj8cawH+cG9shEhQQeEKv0UgFWB4sO/L2nfWiR\nviZjtXiHwB2kipoffDD0lT2I90WGVqkgsFS1hipEoe6op+auxPGkd73VZ1UOOvOJ\nJsDsNEHdNCqXI+EIxzwbJO51WL/rfoFW7TIXzHnzJd1teOKtEqZwI2hAP8OZV5mf\n7bzvb/DKSHOLrYkNHDQxkPmArTQiWiGbLrLn3WMJwlSvETRJv/ZrEJLsTUCElyio\nER2BV0RuAV7qQ4rOW215eAh3L3iYVTj/5IjgZmeLPiRdsJqnqROEYIoy3aARjT8Z\nVvgo11bmmRq0piEWuKMfhIVKQI7NKXdh12XOrDtFvZyHPk1G7hgcnzts7og/OJBV\n5R6GGTJhBwRnaNsMVW2N7RAc4dv+mSg7mlBg90nHQIaxrb4DWocHD7wx2f+/owmb\nOfKbDJAkQivmTq+nhX27lgVFdmFpBnGVd/cQ6FpEQTWGr50G2CV6RSB/+t23TqMj\nlqzx2IEVTttQliSCnyr/dFDQIW4bbl9l1dAsI2zmPDyOtzkdLYUwHHteQmyKEAN9\noF8G5NzVJTR9ie7PaNAUwugOp/JLfo/CmMWB2X9tIys5Lz8VSJE=\n=t/ih\n-----END PGP SIGNATURE-----","payload":"tree a6542c9ec0f7521d438040781758e83680c8b4d7\nparent 3665a81718629c5f424044db745b65a02ef49a3d\nauthor babyblueviper1 <contact@invinoveritas.dev> 1792413740 +0000\ncommitter babyblueviper1 <contact@invinoveritas.dev> 1792413740 +0000\n\nexamples: stdlib cold checker for the work-acceptance record log\n\nRecomputes log_root, the prev_root chain, Merkle roots and enrollment signatures\nfrom the published files, enforces append-only with present/declined final, and\nreports a per-key decline rate over closed records (NOT_MEASURED, never 0).\n","verified_at":null}},"url":"https://api.github.com/repos/babyblueviper1/invinoveritas/commits/ce8c504f2ae4d9b389b53823fe16afec7fcf3bb3","html_url":"https://github.com/babyblueviper1/invinoveritas/commit/ce8c504f2ae4d9b389b53823fe16afec7fcf3bb3","comments_url":"https://api.github.com/repos/babyblueviper1/invinoveritas/commits/ce8c504f2ae4d9b389b53823fe16afec7fcf3bb3/comments","author":{"login":"babyblueviper1","id":241826547,"node_id":"U_kgDODmn68w","avatar_url":"https://avatars.githubusercontent.com/u/241826547?v=4","gravatar_id":"","url":"https://api.github.com/users/babyblueviper1","html_url":"https://github.com/babyblueviper1","followers_url":"https://api.github.com/users/babyblueviper1/followers","following_url":"https://api.github.com/users/babyblueviper1/following{/other_user}","gists_url":"https://api.github.com/users/babyblueviper1/gists{/gist_id}","starred_url":"https://api.github.com/users/babyblueviper1/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/babyblueviper1/subscriptions","organizations_url":"https://api.github.com/users/babyblueviper1/orgs","repos_url":"https://api.github.com/users/babyblueviper1/repos","events_url":"https://api.github.com/users/babyblueviper1/events{/privacy}","received_events_url":"https://api.github.com/users/babyblueviper1/received_events","type":"User","user_view_type":"public","site_admin":false},"committer":{"login":"babyblueviper1","id":241826547,"node_id":"U_kgDODmn68w","avatar_url":"https://avatars.githubusercontent.com/u/241826547?v=4","gravatar_id":"","url":"https://api.github.com/users/babyblueviper1","html_url":"https://github.com/babyblueviper1","followers_url":"https://api.github.com/users/babyblueviper1/followers","following_url":"https://api.github.com/users/babyblueviper1/following{/other_user}","gists_url":"https://api.github.com/users/babyblueviper1/gists{/gist_id}","starred_url":"https://api.github.com/users/babyblueviper1/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/babyblueviper1/subscriptions","organizations_url":"https://api.github.com/users/babyblueviper1/orgs","repos_url":"https://api.github.com/users/babyblueviper1/repos","events_url":"https://api.github.com/users/babyblueviper1/events{/privacy}","received_events_url":"https://api.github.com/users/babyblueviper1/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"3665a81718629c5f424044db745b65a02ef49a3d","url":"https://api.github.com/repos/babyblueviper1/invinoveritas/commits/3665a81718629c5f424044db745b65a02ef49a3d","html_url":"https://github.com/babyblueviper1/invinoveritas/commit/3665a81718629c5f424044db745b65a02ef49a3d"}],"stats":{"total":306,"additions":306,"deletions":0},"files":[{"sha":"accaee7892daacbe46475fc9d761559b389dd4f1","filename":"examples/work-acceptance-record-log/README.md","status":"added","additions":46,"deletions":0,"changes":46,"blob_url":"https://github.com/babyblueviper1/invinoveritas/blob/ce8c504f2ae4d9b389b53823fe16afec7fcf3bb3/examples%2Fwork-acceptance-record-log%2FREADME.md","raw_url":"https://github.com/babyblueviper1/invinoveritas/raw/ce8c504f2ae4d9b389b53823fe16afec7fcf3bb3/examples%2Fwork-acceptance-record-log%2FREADME.md","contents_url":"https://api.github.com/repos/babyblueviper1/invinoveritas/contents/examples%2Fwork-acceptance-record-log%2FREADME.md?ref=ce8c504f2ae4d9b389b53823fe16afec7fcf3bb3","patch":"@@ -0,0 +1,46 @@\n+# Work-acceptance record log: cold checker\n+\n+`record_log_check.py` checks the enumerable record log at `https://api.babyblueviper.com/work-acceptance/records/log`. It uses the Python 3 standard library only and needs nothing from us beyond the published files.\n+\n+```\n+python3 record_log_check.py                         # the live index and every day file\n+python3 record_log_check.py --dir ./copy            # a local copy (index.json + <date>.jsonl)\n+python3 record_log_check.py --key did:key:z6Mk...   # one producer's state\n+```\n+\n+## What it proves from the files alone\n+\n+For each day, it checks:\n+- the file hash\n+- the header line, by recomputing `log_root = sha256(JCS(header))`\n+- the `prev_root` chain from 64 zeros\n+- that the days are consecutive\n+- the Merkle root over the body\n+- the header counts\n+- every enrollment's Ed25519 signature over `invinoveritas work-acceptance enrollment v1 <key>`, using an embedded RFC 8032 verifier\n+\n+Across days, it checks that every line listed on one day appears unchanged on the next. Only `producer_signature` may change, and only from `absent` to `present` or `declined`. `present` and `declined` are final, so a co-signature added after the 72 h grace never turns a listed decline into a pass.\n+\n+For each producer key, it reports present, absent and declined counts. The decline rate covers closed records only (`present` + `declined`).\n+- With no closed records, the rate is `NOT_MEASURED`, never `0`.\n+- A key with no enrollment line is `NOT_MEASURED (not enrolled)`.\n+\n+An empty set and a set with no declines are different facts, so they never print the same thing.\n+\n+## What it does not prove\n+\n+- **OpenTimestamps proofs:** not checked here. Tie each `log_root` to its Bitcoin block with `ots verify <date>.ots`, where the digest is `log_root`.\n+- **Completeness:** rests on the issuer listing every covered record. What the files make provable is narrower: nothing listed is later dropped, rewritten or re-dated. Two different files for one date also show up against their anchors.\n+- **Identity across keys:** the set is enumerable per key, not per party. Tying two keys to one producer is outside the log.\n+\n+## Tested against\n+\n+- **The live log (2 days, 2026-10-17 and 2026-10-18):** all checks pass, and no producer is enrolled.\n+- **A generated 3-day log** with one enrollment, one co-signed record and one declined record: it passes.\n+- **Six tampered copies of that log:** each one fails. The tampering was:\n+  - present changed to declined\n+  - declined changed to present\n+  - a record dropped\n+  - a record re-dated\n+  - a bad enrollment signature\n+  - an edited file"},{"sha":"001989097604939e0b210dde9513b639af0eb888","filename":"examples/work-acceptance-record-log/record_log_check.py","status":"added","additions":260,"deletions":0,"changes":260,"blob_url":"https://github.com/babyblueviper1/invinoveritas/blob/ce8c504f2ae4d9b389b53823fe16afec7fcf3bb3/examples%2Fwork-acceptance-record-log%2Frecord_log_check.py","raw_url":"https://github.com/babyblueviper1/invinoveritas/raw/ce8c504f2ae4d9b389b53823fe16afec7fcf3bb3/examples%2Fwork-acceptance-record-log%2Frecord_log_check.py","contents_url":"https://api.github.com/repos/babyblueviper1/invinoveritas/contents/examples%2Fwork-acceptance-record-log%2Frecord_log_check.py?ref=ce8c504f2ae4d9b389b53823fe16afec7fcf3bb3","patch":"@@ -0,0 +1,260 @@\n+#!/usr/bin/env python3\n+\"\"\"Cold checker for the invinoveritas work-acceptance record log (schema invinoveritas.work-acceptance.record_log.v1).\n+\n+Python 3 stdlib only. It checks the published files against each other and needs nothing from us beyond the bytes:\n+\n+  python3 record_log_check.py                                   # fetch the live index and every day file\n+  python3 record_log_check.py --dir ./log                       # or a local copy: index.json (or index.jsonl) + <date>.jsonl\n+  python3 record_log_check.py --key did:key:z6Mk...             # one producer's state\n+\n+What it checks, per day:\n+  1. sha256(file) equals the index's file_sha256.\n+  2. The first line is the header; sha256(JCS(header)) equals the index's log_root.\n+  3. header.prev_root equals the previous day's log_root (the first day: 64 zeros); days are consecutive.\n+  4. The Merkle root over sha256(line) of the body equals header.merkle_root; n_enrollments / n_records match the body.\n+  5. Every enrollment line's Ed25519 signature verifies over \"invinoveritas work-acceptance enrollment v1 <key>\" with that key.\n+Across days:\n+  6. Append-only: every line of day N is in day N+1 unchanged, except producer_signature, which may only move from\n+     'absent' to 'present' or 'declined'. 'present' and 'declined' are final.\n+Per producer key (the latest day):\n+  7. records, present / absent / declined, and a decline rate over CLOSED records only (present + declined). With no closed\n+     records the rate is NOT_MEASURED, never 0. A key with no enrollment line is NOT_MEASURED (not enrolled): the log says\n+     nothing about it, and that is not the same fact as \"no declines\".\n+\n+Not checked here: the OpenTimestamps proofs. Run `ots verify <date>.ots` against sha256 = log_root to tie each root to its\n+Bitcoin block. Completeness itself rests on the issuer listing every covered record; what this checker makes provable is\n+that nothing listed was later dropped, rewritten or re-dated.\n+\"\"\"\n+import argparse\n+import hashlib\n+import json\n+import os\n+import sys\n+import urllib.request\n+\n+SCHEMA = \"invinoveritas.work-acceptance.record_log.v1\"\n+GENESIS = \"0\" * 64\n+EMPTY_ROOT = hashlib.sha256(f\"{SCHEMA}|empty\".encode()).hexdigest()\n+ENROLL_STATEMENT = \"invinoveritas work-acceptance enrollment v1 {key}\"\n+DEFAULT_BASE = \"https://api.babyblueviper.com/work-acceptance/records/log\"\n+\n+\n+def jcs(v):\n+    # RFC 8785 for the values these files carry (objects, arrays, strings, integers)\n+    return json.dumps(v, sort_keys=True, separators=(\",\", \":\"), ensure_ascii=False).encode(\"utf-8\")\n+\n+\n+def merkle_root(leaves):\n+    if not leaves:\n+        return EMPTY_ROOT\n+    level = list(leaves)\n+    while len(level) > 1:\n+        level = [hashlib.sha256((level[i] + (level[i + 1] if i + 1 < len(level) else level[i])).encode()).hexdigest()\n+                 for i in range(0, len(level), 2)]\n+    return level[0]\n+\n+\n+# ---- Ed25519 verify (RFC 8032 section 5.1.7), stdlib only ----\n+_P = 2 ** 255 - 19\n+_L = 2 ** 252 + 27742317777372353535851937790883648493\n+_D = -121665 * pow(121666, _P - 2, _P) % _P\n+_I = pow(2, (_P - 1) // 4, _P)\n+\n+\n+def _recover_x(y, sign):\n+    xx = (y * y - 1) * pow(_D * y * y + 1, _P - 2, _P)\n+    x = pow(xx, (_P + 3) // 8, _P)\n+    if (x * x - xx) % _P:\n+        x = x * _I % _P\n+    if (x * x - xx) % _P:\n+        return None\n+    if x == 0 and sign:\n+        return None\n+    return _P - x if (x & 1) != sign else x\n+\n+\n+def _decode_point(b):\n+    if len(b) != 32:\n+        return None\n+    y = int.from_bytes(b, \"little\")\n+    sign, y = y >> 255, y & ((1 << 255) - 1)\n+    if y >= _P:\n+        return None\n+    x = _recover_x(y, sign)\n+    return None if x is None else (x, y, 1, x * y % _P)\n+\n+\n+def _add(p, q):\n+    a = (p[1] - p[0]) * (q[1] - q[0]) % _P\n+    b = (p[1] + p[0]) * (q[1] + q[0]) % _P\n+    c = 2 * p[3] * q[3] * _D % _P\n+    d = 2 * p[2] * q[2] % _P\n+    e, f, g, h = b - a, d - c, d + c, b + a\n+    return (e * f % _P, g * h % _P, f * g % _P, e * h % _P)\n+\n+\n+def _mul(s, p):\n+    q = (0, 1, 1, 0)\n+    while s:\n+        if s & 1:\n+            q = _add(q, p)\n+        p = _add(p, p)\n+        s >>= 1\n+    return q\n+\n+\n+def _eq(p, q):\n+    return (p[0] * q[2] - q[0] * p[2]) % _P == 0 and (p[1] * q[2] - q[1] * p[2]) % _P == 0\n+\n+\n+_G = _decode_point(bytes.fromhex(\"5866666666666666666666666666666666666666666666666666666666666666\"))\n+\n+\n+def ed25519_verify(pub, msg, sig):\n+    if len(sig) != 64:\n+        return False\n+    a, r = _decode_point(pub), _decode_point(sig[:32])\n+    s = int.from_bytes(sig[32:], \"little\")\n+    if a is None or r is None or s >= _L:\n+        return False\n+    k = int.from_bytes(hashlib.sha512(sig[:32] + pub + msg).digest(), \"little\") % _L\n+    return _eq(_mul(s, _G), _add(r, _mul(k, a)))\n+\n+\n+_B58 = \"123456789ABCDEFGHJKLMNPQRSTUVWXYZabcdefghijkmnopqrstuvwxyz\"\n+\n+\n+def did_key_ed25519(key):\n+    \"\"\"did:key:z6Mk... -> 32-byte Ed25519 public key, or None.\"\"\"\n+    if not key.startswith(\"did:key:z\"):\n+        return None\n+    n = 0\n+    for ch in key[len(\"did:key:z\"):]:\n+        if ch not in _B58:\n+            return None\n+        n = n * 58 + _B58.index(ch)\n+    raw = n.to_bytes((n.bit_length() + 7) // 8, \"big\")\n+    raw = b\"\\x00\" * (len(key[len(\"did:key:z\"):]) - len(key[len(\"did:key:z\"):].lstrip(\"1\"))) + raw\n+    return raw[2:] if len(raw) == 34 and raw[:2] == b\"\\xed\\x01\" else None\n+\n+\n+# ---- loading ----\n+def fetch(url):\n+    with urllib.request.urlopen(urllib.request.Request(url, headers={\"User-Agent\": \"record_log_check/1\"}), timeout=30) as r:\n+        return r.read()\n+\n+\n+def load(args):\n+    if args.dir:\n+        for name in (\"index.json\", \"index.jsonl\"):\n+            p = os.path.join(args.dir, name)\n+            if os.path.exists(p):\n+                raw = open(p, \"rb\").read().decode()\n+                days = json.loads(raw)[\"days\"] if name == \"index.json\" else [json.loads(x) for x in raw.splitlines() if x.strip()]\n+                break\n+        else:\n+            sys.exit(f\"no index.json or index.jsonl in {args.dir}\")\n+        return days, lambda d: open(os.path.join(args.dir, f\"{d}.jsonl\"), \"rb\").read()\n+    idx = json.loads(fetch(args.base))\n+    if idx.get(\"schema\") != SCHEMA:\n+        sys.exit(f\"unexpected schema {idx.get('schema')!r}\")\n+    return idx[\"days\"], lambda d: fetch(f\"{args.base}/{d}.jsonl\")\n+\n+\n+def main():\n+    ap = argparse.ArgumentParser(description=__doc__.splitlines()[0])\n+    ap.add_argument(\"--base\", default=DEFAULT_BASE, help=\"log index URL (default: the live one)\")\n+    ap.add_argument(\"--dir\", help=\"local directory instead of fetching\")\n+    ap.add_argument(\"--key\", action=\"append\", default=[], help=\"report this producer key (repeatable)\")\n+    args = ap.parse_args()\n+\n+    days, read = load(args)\n+    days = sorted(days, key=lambda x: x[\"date\"])\n+    fails, prev_root, prev_lines, prev_date = [], GENESIS, None, None\n+    import datetime as dt\n+\n+    def fail(msg):\n+        fails.append(msg)\n+        print(\"FAIL \" + msg)\n+\n+    last_body = []\n+    for day in days:\n+        d = day[\"date\"]\n+        data = read(d)\n+        if hashlib.sha256(data).hexdigest() != day[\"file_sha256\"]:\n+            fail(f\"{d}: sha256(file) != index file_sha256\")\n+        rows = data.decode(\"utf-8\").split(\"\\n\")\n+        if rows and rows[-1] == \"\":\n+            rows = rows[:-1]\n+        try:\n+            header, body = json.loads(rows[0]), rows[1:]\n+            lines = [json.loads(x) for x in body]\n+        except (ValueError, IndexError):\n+            fail(f\"{d}: a line is not JSON; day not checked further\")\n+            continue\n+        if header.get(\"schema\") != SCHEMA or header.get(\"date\") != d:\n+            fail(f\"{d}: header schema/date mismatch\")\n+        if jcs(header).decode() != rows[0]:\n+            fail(f\"{d}: header line is not JCS\")\n+        root = hashlib.sha256(jcs(header)).hexdigest()\n+        if root != day[\"log_root\"]:\n+            fail(f\"{d}: sha256(JCS(header)) {root[:12]} != index log_root {day['log_root'][:12]}\")\n+        if header.get(\"prev_root\") != prev_root:\n+            fail(f\"{d}: prev_root {str(header.get('prev_root'))[:12]} does not chain to {prev_root[:12]}\")\n+        if prev_date and dt.date.fromisoformat(d) != dt.date.fromisoformat(prev_date) + dt.timedelta(days=1):\n+            fail(f\"{d}: not the day after {prev_date}\")\n+        if merkle_root([hashlib.sha256(b.encode()).hexdigest() for b in body]) != header.get(\"merkle_root\"):\n+            fail(f\"{d}: merkle_root does not recompute\")\n+        if any(jcs(x).decode() != b for x, b in zip(lines, body)):\n+            fail(f\"{d}: a body line is not JCS\")\n+        n_e = sum(1 for x in lines if x.get(\"type\") == \"enrollment\")\n+        n_r = sum(1 for x in lines if x.get(\"type\") == \"record\")\n+        if (n_e, n_r) != (header.get(\"n_enrollments\"), header.get(\"n_records\")):\n+            fail(f\"{d}: header counts {header.get('n_enrollments')}/{header.get('n_records')} != body {n_e}/{n_r}\")\n+        for e in (x for x in lines if x.get(\"type\") == \"enrollment\"):\n+            pub = did_key_ed25519(e.get(\"key\", \"\"))\n+            ok = pub is not None and e.get(\"statement\") == ENROLL_STATEMENT.format(key=e[\"key\"])\n+            try:\n+                import base64\n+                ok = ok and ed25519_verify(pub, e[\"statement\"].encode(), base64.b64decode(e.get(\"signature\", \"\"), validate=True))\n+            except ValueError:\n+                ok = False\n+            if not ok:\n+                fail(f\"{d}: enrollment signature does not verify for {e.get('key')}\")\n+        if prev_lines is not None:\n+            cur = {(x[\"type\"], x.get(\"key\") or x.get(\"receipt_sha256\")): x for x in lines}\n+            for k, old in prev_lines.items():\n+                new = cur.get(k)\n+                if new is None:\n+                    fail(f\"{d}: {k[0]} {k[1][:16]} listed on {prev_date} is missing\")\n+                    continue\n+                strip = lambda x: {a: b for a, b in x.items() if a != \"producer_signature\"}\n+                if strip(new) != strip(old):\n+                    fail(f\"{d}: {k[0]} {k[1][:16]} changed since {prev_date}\")\n+                o, n = old.get(\"producer_signature\"), new.get(\"producer_signature\")\n+                if o != n and o != \"absent\":\n+                    fail(f\"{d}: record {k[1][:16]} moved {o} -> {n} (only 'absent' may change)\")\n+        print(f\"ok   {d}: log_root {root[:16]} chains to {prev_root[:16]}; {n_e} enrollments, {n_r} records\"\n+              + (f\"; Bitcoin block {day['bitcoin_block_height']} per index (check with ots verify)\" if day.get(\"bitcoin_block_height\") else \"\"))\n+        prev_root, prev_date, last_body = root, d, lines\n+        prev_lines = {(x[\"type\"], x.get(\"key\") or x.get(\"receipt_sha256\")): x for x in lines}\n+\n+    enrolled = {x[\"key\"] for x in last_body if x.get(\"type\") == \"enrollment\"}\n+    keys = list(dict.fromkeys(args.key or sorted(enrolled)))\n+    print(f\"\\nproducers (as of {prev_date or 'no days'}):\" if keys else f\"\\nproducers (as of {prev_date or 'no days'}): none enrolled, so no producer is measurable\")\n+    for k in keys:\n+        if k not in enrolled:\n+            print(f\"  {k}: NOT_MEASURED (not enrolled; the log says nothing about this key)\")\n+            continue\n+        st = [x[\"producer_signature\"] for x in last_body if x.get(\"type\") == \"record\" and x.get(\"producer_key\") == k]\n+        p, a, dcl = st.count(\"present\"), st.count(\"absent\"), st.count(\"declined\")\n+        closed = p + dcl\n+        rate = f\"{dcl}/{closed} declined\" if closed else \"NOT_MEASURED (no closed records)\"\n+        print(f\"  {k}: {len(st)} records (present {p}, absent {a}, declined {dcl}); decline rate {rate}\")\n+\n+    print(f\"\\n{'FAILED: ' + str(len(fails)) if fails else 'ALL CHECKS PASS'} ({len(days)} days)\")\n+    sys.exit(1 if fails else 0)\n+\n+\n+if __name__ == \"__main__\":\n+    main()"}]}