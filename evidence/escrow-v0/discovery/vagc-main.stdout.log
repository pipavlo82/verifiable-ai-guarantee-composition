tions (test_composition.CompositionTests.test_mutation_classifications) ... ok\n+test_no_real_crypto_claim_in_any_case (test_composition.CompositionTests.test_no_real_crypto_claim_in_any_case) ... ok\n+test_nonobject_packet_unverifiable (test_composition.CompositionTests.test_nonobject_packet_unverifiable) ... ok\n+test_real_mode_even_with_flags_is_unimplemented (test_composition.CompositionTests.test_real_mode_even_with_flags_is_unimplemented) ... ok\n+test_repeat_deterministic_and_no_mutation (test_composition.CompositionTests.test_repeat_deterministic_and_no_mutation) ... ok\n+test_unknown_mechanism_is_not_false_proof (test_composition.CompositionTests.test_unknown_mechanism_is_not_false_proof) ... ok\n+\n+----------------------------------------------------------------------\n+Ran 19 tests in 0.275s\n+\n+OK"},{"sha":"e69de29bb2d1d6434b8b29ae775ad8c2e48c5391","filename":"research/formal-v1/evidence/v0-regression/tests-repeat.stdout.log","status":"added","additions":0,"deletions":0,"changes":0,"blob_url":"https://github.com/pipavlo82/verifiable-ai-guarantee-composition/blob/18a5916098addf6447700ed95441125bfa7079c3/research%2Fformal-v1%2Fevidence%2Fv0-regression%2Ftests-repeat.stdout.log","raw_url":"https://github.com/pipavlo82/verifiable-ai-guarantee-composition/raw/18a5916098addf6447700ed95441125bfa7079c3/research%2Fformal-v1%2Fevidence%2Fv0-regression%2Ftests-repeat.stdout.log","contents_url":"https://api.github.com/repos/pipavlo82/verifiable-ai-guarantee-composition/contents/research%2Fformal-v1%2Fevidence%2Fv0-regression%2Ftests-repeat.stdout.log?ref=18a5916098addf6447700ed95441125bfa7079c3"},{"sha":"16d35db8467b2de7940963ab49334bca3ef34951","filename":"research/formal-v1/model.py","status":"added","additions":143,"deletions":0,"changes":143,"blob_url":"https://github.com/pipavlo82/verifiable-ai-guarantee-composition/blob/18a5916098addf6447700ed95441125bfa7079c3/research%2Fformal-v1%2Fmodel.py","raw_url":"https://github.com/pipavlo82/verifiable-ai-guarantee-composition/raw/18a5916098addf6447700ed95441125bfa7079c3/research%2Fformal-v1%2Fmodel.py","contents_url":"https://api.github.com/repos/pipavlo82/verifiable-ai-guarantee-composition/contents/research%2Fformal-v1%2Fmodel.py?ref=18a5916098addf6447700ed95441125bfa7079c3","patch":"@@ -0,0 +1,143 @@\n+\"\"\"Equality obligations under explicit assumptions; not an authorization verifier.\n+\n+This module has no cryptographic verification API. Its finite model and typed\n+commitments are research objects, not zkIE/WYRIWE/ReceiptOS wire formats.\n+\"\"\"\n+import hashlib\n+import itertools\n+import json\n+\n+GROUPS = {\n+    \"input\": (\"requested_input\", \"provenance_input\", \"inference_input\"),\n+    \"model\": (\"requested_model\", \"provenance_model\", \"inference_model\"),\n+    \"action\": (\"requested_action\", \"judged_action\", \"executed_action\"),\n+}\n+EDGES = {\n+    f\"{dimension}.{pair}\": (nodes[left], nodes[right])\n+    for dimension, nodes in GROUPS.items()\n+    for pair, left, right in ((\"RP\", 0, 1), (\"PI\", 1, 2), (\"RI\", 0, 2))\n+}\n+NODES = tuple(node for group in GROUPS.values() for node in group)\n+TARGETS = tuple((nodes[0], other) for nodes in GROUPS.values() for other in nodes[1:])\n+\n+\n+def components(selected, native=()):\n+    chosen = set(selected) | set(native)\n+    if not chosen <= EDGES.keys():\n+        raise ValueError(\"Unknown obligation identifier\")\n+    roots = {node: node for node in NODES}\n+    def root(node):\n+        while roots[node] != node:\n+            node = roots[node]\n+        return node\n+    for name in sorted(chosen):\n+        left, right = EDGES[name]\n+        roots[root(right)] = root(left)\n+    return {node: root(node) for node in NODES}\n+\n+\n+def entails(selected, native=()):\n+    groups = components(selected, native)\n+    return all(groups[left] == groups[right] for left, right in TARGETS)\n+\n+\n+def witness(selected, native=()):\n+    groups = components(selected, native)\n+    for left, right in TARGETS:\n+        if groups[left] != groups[right]:\n+            return {node: int(groups[node] == groups[right]) for node in NODES}\n+    return None\n+\n+\n+def satisfies_edges(assignment, selected):\n+    return all(assignment[EDGES[name][0]] == assignment[EDGES[name][1]] for name in selected)\n+\n+\n+def target_semantics(assignment):\n+    # Separate oracle: direct three-way equality, no use of graph closure.\n+    return all(assignment[a] == assignment[b] == assignment[c] for a, b, c in GROUPS.values())\n+\n+\n+def compare_commitments(left, right):\n+    \"\"\"A narrow research relation. Algorithm+representation labels are mandatory.\n+\n+    Caller-authenticated labels are an assumption; this does not authenticate them.\n+    A missing bridge between unlike representations is unknown, not a refutation.\n+    \"\"\"\n+    if type(left) is not dict or type(right) is not dict:\n+        return \"UNVERIFIABLE\"\n+    required = {\"algorithm\", \"representation\", \"digest\"}\n+    if set(left) != required or set(right) != required:\n+        return \"UNVERIFIABLE\"\n+    for item in (left, right):\n+        if type(item[\"algorithm\"]) is not str or item[\"algorithm\"] not in {\"sha256\", \"keccak256\"} or type(item[\"representation\"]) is not str or not item[\"representation\"]:\n+            return \"UNVERIFIABLE\"\n+        if type(item[\"digest\"]) is not str or len(item[\"digest\"]) != 64 or any(c not in \"0123456789abcdef\" for c in item[\"digest\"]):\n+            return \"UNVERIFIABLE\"\n+    if (left[\"algorithm\"], left[\"representation\"]) != (right[\"algorithm\"], right[\"representation\"]):\n+        return \"UNVERIFIABLE\"\n+    return \"VERIFIED\" if left[\"digest\"] == right[\"digest\"] else \"REFUTED\"\n+\n+\n+def analyze(native=()):\n+    native = frozenset(native)\n+    if not native <= EDGES.keys():\n+        raise ValueError(\"Unknown native premise\")\n+    candidates = tuple(sorted(set(EDGES) - native))\n+    assignments = [dict(zip(NODES, values)) for values in itertools.product((0, 1), repeat=len(NODES))]\n+    compatible = [a for a in assignments if satisfies_edges(a, native)]\n+    # Compact bit masks for the independent exhaustive oracle.\n+    semantic_rows = [(sum(1 << i for i, e in enumerate(candidates) if satisfies_edges(a, [e])), target_semantics(a)) for a in compatible]\n+    sufficient = []\n+    certificates = []\n+    evaluations = 0\n+    for mask in range(1 << len(candidates)):\n+        chosen = frozenset(e for i, e in enumerate(candidates) if mask & (1 << i))\n+        graph_result = entails(chosen, native)\n+        oracle = True\n+        # Do not short-circuit: count every audited assignment/subset pair.\n+        for satisfied_mask, target in semantic_rows:\n+            if mask & satisfied_mask == mask and not target:\n+                oracle = False\n+            evaluations += 1\n+        if graph_result != oracle:\n+            raise RuntimeError(\"Graph closure disagrees with exhaustive semantics\")\n+        if graph_result:\n+            sufficient.append(chosen)\n+        else:\n+            assignment = witness(chosen, native)\n+            if assignment is None or not satisfies_edges(assignment, chosen | native) or target_semantics(assignment):\n+                raise RuntimeError(\"Invalid necessity witness\")\n+    minimal = [s for s in sufficient if not any(entails(s - {edge}, native) for edge in s)]\n+    for basis in minimal:\n+        for edge in sorted(basis):\n+            reduced = basis - {edge}\n+            assignment = witness(reduced, native)\n+            if not satisfies_edges(assignment, reduced | native) or target_semantics(assignment):\n+                raise RuntimeError(\"Removed obligation has no semantic counterexample\")\n+            certificates.append({\"basis\": sorted(basis), \"removed\": edge, \"countermodel\": assignment})\n+    return {\"native_premises\": sorted(native), \"candidate_edges\": len(candidates), \"subsets\": 1 << len(candidates),\n+            \"assignments\": len(compatible), \"oracle_evaluations\": evaluations, \"sufficient_sets\": len(sufficient),\n+            \"inclusion_minimal_bases\": [sorted(s) for s in sorted(minimal, key=lambda s: tuple(sorted(s)))],\n+            \"minimum_cardinality\": min(map(len, sufficient)), \"removal_countermodels\": certificates,\n+            \"all_observed_minimal_bases_are_minimum\": len({len(s) for s in minimal}) == 1}\n+\n+\n+def run():\n+    # Equal normalized values cannot establish byte identity: normalization is not injective.\n+    left, right = b\"3\", b\"003\"\n+    return {\"schema\": \"composition-obligation-analysis-v1\", \"mode\": \"ABSTRACT_EQUALITY_MODEL\",\n+            \"cryptographic_verification\": \"NOT_PERFORMED\", \"downstream_authorization\": \"NOT_ESTABLISHED\",\n+            \"hypotheses\": [\"sound native verifiers\", \"trusted caller policy and authority\", \"verified representation bridges\", \"applicable scope/time/replay checks\", \"authenticated subject and execution linkage\"],\n+            \"without_cross_component_native_equalities\": analyze(),\n+            \"conditional_on_one_additional_verified_equality\": analyze([\"model.PI\"]),\n+            \"noninjective_translation_counterexample\": {\"left_hex\": left.hex(), \"right_hex\": right.hex(),\n+                \"normalized_equal\": int(left) == int(right), \"raw_equal\": left == right,\n+                \"left_sha256\": hashlib.sha256(left).hexdigest(), \"right_sha256\": hashlib.sha256(right).hexdigest()},\n+            \"novelty\": \"Application-specific candidate; no priority claim for equality closure, graph minimality or assume-guarantee reasoning.\"}\n+\n+\n+if __name__ == \"__main__\":\n+    import sys\n+    sys.stdout.reconfigure(newline=\"\\n\")\n+    print(json.dumps(run(), sort_keys=True, indent=2))"},{"sha":"495bd29ed6e785f4b6a91350493e98a9f8b85fbb","filename":"research/formal-v1/mutations.py","status":"added","additions":72,"deletions":0,"changes":72,"blob_url":"https://github.com/pipavlo82/verifiable-ai-guarantee-composition/blob/18a5916098addf6447700ed95441125bfa7079c3/research%2Fformal-v1%2Fmutations.py","raw_url":"https://github.com/pipavlo82/verifiable-ai-guarantee-composition/raw/18a5916098addf6447700ed95441125bfa7079c3/research%2Fformal-v1%2Fmutations.py","contents_url":"https://api.github.com/repos/pipavlo82/verifiable-ai-guarantee-composition/contents/research%2Fformal-v1%2Fmutations.py?ref=18a5916098addf6447700ed95441125bfa7079c3","patch":"@@ -0,0 +1,72 @@\n+\"\"\"Behavioral source mutants. Exceptions are CRASHED, never automatically KILLED.\"\"\"\n+import hashlib\n+import json\n+import subprocess\n+from pathlib import Path\n+\n+ROOT = Path(__file__).resolve().parent\n+\n+def run(dependency_root, scratch):\n+    scratch = Path(scratch)\n+    scratch.mkdir(parents=True, exist_ok=True)\n+    original = (ROOT / 'model.py').read_text(encoding='utf-8')\n+    baseline = {'__name__': 'baseline'}\n+    exec(compile(original, 'baseline', 'exec'), baseline)\n+    left = {'algorithm': 'sha256', 'representation': 'raw', 'digest': 'a' * 64}\n+    right = dict(left, representation='normalized')\n+    rows = []\n+    changes = [\n+        ('closure', 'return all(groups[left] == groups[right] for left, right in TARGETS)', 'return True'),\n+        ('representation', 'if (left[\"algorithm\"], left[\"representation\"]) != (right[\"algorithm\"], right[\"representation\"]):', 'if False:')]\n+    for name, old, new in changes:\n+        row = {'name': name, 'classification': 'NOT_APPLIED'}\n+        if original.count(old) == 1:\n+            try:\n+                ns = {'__name__': 'mutant'}\n+                exec(compile(original.replace(old, new), 'mutant-' + name, 'exec'), ns)\n+                if name == 'closure':\n+                    before, after = baseline['entails']([]), ns['entails']([])\n+                    positive = ns['entails'](ns['EDGES'])\n+                    killed = before is False and after is True and positive is True\n+                else:\n+                    before, after = baseline['compare_commitments'](left, right), ns['compare_commitments'](left, right)\n+                    positive = ns['compare_commitments'](left, left)\n+                    killed = before == 'UNVERIFIABLE' and after == positive == 'VERIFIED'\n+                row.update(before=before, after=after, positive_control=positive, classification='KILLED' if killed else 'SURVIVED')\n+            except Exception as error:\n+                row.update(classification='CRASHED', error=type(error).__name__)\n+        rows.append(row)\n+    script = (ROOT / 'crypto/check.mjs').read_text(encoding='utf-8')\n+    (scratch / 'ledger-19-event.json').write_bytes((ROOT / 'crypto/ledger-19-event.json').read_bytes())\n+    replacements = [\n+        ('signature_verification', \"return schnorr.verify(Buffer.from(e.sig, 'hex'), Buffer.from(id, 'hex'), Buffer.from(e.pubkey, 'hex')) ? 'VERIFIED' : 'REFUTED';\", \"return 'VERIFIED';\", 'changed_signature'),\n+        ('proposal_binding', \"return content.artifact_hash === requestedDigest ? 'VERIFIED' : 'REFUTED';\", \"return 'VERIFIED';\", 'wrong_proposal_same_authentic_event')]\n+    for name, old, new, target in replacements:\n+        row = {'name': name, 'classification': 'NOT_APPLIED', 'target': target}\n+        if script.count(old) == 1:\n+            try:\n+                path = scratch / (name + '.mjs')\n+                path.write_text(script.replace(old, new), encoding='utf-8', newline='\\n')\n+                proc = subprocess.run(['node', str(path), str(Path(dependency_root).resolve())], capture_output=True, timeout=30)\n+                (scratch / (name + '.stdout.json')).write_bytes(proc.stdout)\n+                (scratch / (name + '.stderr.log')).write_bytes(proc.stderr)\n+                if proc.returncode not in (0, 1):\n+                    raise RuntimeError('Mutation process failed')\n+                report = json.loads(proc.stdout)\n+                observed = {r['name']: r for r in report['cases']}\n+                killed = observed[target]['actual'] == 'VERIFIED' and not observed[target]['passed'] and observed['original_signature']['passed']\n+                row.update(before='REFUTED', after=observed[target]['actual'], positive_control=observed['original_signature']['actual'],\n+                           classification='KILLED' if killed else 'SURVIVED', exit=proc.returncode,\n+                           output_sha256=hashlib.sha256(proc.stdout).hexdigest())\n+            except Exception as error:\n+                row.update(classification='CRASHED', error=type(error).__name__)\n+        rows.append(row)\n+    # Restore is literal: originals were never changed. Confirm behavior once more.\n+    restored = (ROOT / 'model.py').read_text(encoding='utf-8') == original and (ROOT / 'crypto/check.mjs').read_text(encoding='utf-8') == script\n+    restored = restored and baseline['entails']([]) is False and baseline['compare_commitments'](left, right) == 'UNVERIFIABLE'\n+    p = subprocess.run(['node', str(ROOT / 'crypto/check.mjs'), str(Path(dependency_root).resolve())], capture_output=True, timeout=30)\n+    restored = restored and p.returncode == 0 and json.loads(p.stdout)['passed']\n+    counts = {key: sum(r['classification'] == key for r in rows) for key in ('KILLED', 'SURVIVED', 'CRASHED', 'NOT_APPLIED', 'UNVERIFIABLE')}\n+    return {'schema': 'formal-v1-mutations', 'controls': rows, 'counts': counts, 'restored': restored,\n+            'passed': restored and counts['KILLED'] == 4,\n+            'scope': 'Four implementation controls; 252 abstract removal countermodels are separate, not counted as source mutants.'}"},{"sha":"ec8b52f9a51bd4b1d6e2b6a7c213c60b7eacdd7d","filename":"research/formal-v1/native_probe.py","status":"added","additions":48,"deletions":0,"changes":48,"blob_url":"https://github.com/pipavlo82/verifiable-ai-guarantee-composition/blob/18a5916098addf6447700ed95441125bfa7079c3/research%2Fformal-v1%2Fnative_probe.py","raw_url":"https://github.com/pipavlo82/verifiable-ai-guarantee-composition/raw/18a5916098addf6447700ed95441125bfa7079c3/research%2Fformal-v1%2Fnative_probe.py","contents_url":"https://api.github.com/repos/pipavlo82/verifiable-ai-guarantee-composition/contents/research%2Fformal-v1%2Fnative_probe.py?ref=18a5916098addf6447700ed95441125bfa7079c3","patch":"@@ -0,0 +1,48 @@\n+\"\"\"Run two pinned native zkIE library tests; no portable proof or authorization claim.\"\"\"\n+import argparse\n+import hashlib\n+import json\n+import os\n+import subprocess\n+from pathlib import Path\n+\n+PIN = '39d8df96877bc3bebf33c69b06907d792b3184b9'\n+\n+def main():\n+    p = argparse.ArgumentParser()\n+    p.add_argument('--zkie-clone', required=True)\n+    p.add_argument('--cache-dir', required=True)\n+    p.add_argument('--out', required=True)\n+    p.add_argument('--online', action='store_true', help='Allow Cargo to fetch pinned dependencies; default offline')\n+    args = p.parse_args()\n+    clone, cache, out = (Path(v).resolve() for v in (args.zkie_clone, args.cache_dir, args.out))\n+    out.mkdir(parents=True, exist_ok=True)\n+    if subprocess.check_output(['git', 'rev-parse', 'HEAD'], cwd=clone, text=True).strip() != PIN:\n+        raise RuntimeError('Unexpected zkIE commit')\n+    if subprocess.check_output(['git', 'status', '--porcelain'], cwd=clone):\n+        raise RuntimeError('Use a clean upstream checkout')\n+    env = dict(os.environ, CARGO_TARGET_DIR=str(cache / 'cargo-target'), CARGO_HOME=str(cache / 'cargo-home'), CARGO_TERM_COLOR='never')\n+    rows = []\n+    for target in ('compose::tests::op_shard_matmul_roundtrip', 'compose::tests::committed_projection_roundtrip'):\n+        command = ['cargo', 'test', '--locked', '-p', 'zkie-ops', target]\n+        if not args.online:\n+            command.append('--offline')\n+        command += ['--', '--exact', '--nocapture']\n+        result = subprocess.run(command, cwd=clone, env=env, capture_output=True, timeout=900)\n+        name = target.split('::')[-1]\n+        for stream in ('stdout', 'stderr'):\n+            (out / (name + '.' + stream + '.log')).write_bytes(getattr(result, stream))\n+        rows.append({'target': target, 'exit': result.returncode, 'executed': b'1 passed; 0 failed' in result.stdout,\n+                     'stdout_sha256': hashlib.sha256(result.stdout).hexdigest(), 'stderr_sha256': hashlib.sha256(result.stderr).hexdigest()})\n+    clean = not subprocess.check_output(['git', 'status', '--porcelain'], cwd=clone)\n+    report = {'pin': PIN, 'cargo_lock_sha256': hashlib.sha256((clone / 'Cargo.lock').read_bytes()).hexdigest(),\n+              'rustc': subprocess.check_output(['rustc', '--version'], text=True).strip(),\n+              'cargo': subprocess.check_output(['cargo', '--version'], text=True).strip(),\n+              'runs': rows, 'clean_upstream': clean, 'passed': clean and all(r['exit'] == 0 and r['executed'] for r in rows),\n+              'portable_proof_capture': 'NOT_IMPLEMENTED', 'end_to_end_authorization': 'NOT_IMPLEMENTED'}\n+    (out / 'report.json').write_text(json.dumps(report, indent=2) + '\\n', encoding='utf-8', newline='\\n')\n+    print(json.dumps(report, indent=2))\n+    return 0 if report['passed'] else 1\n+\n+if __name__ == '__main__':\n+    raise SystemExit(main())"},{"sha":"223ab2f606d79924a99405a2454eb571d01af976","filename":"research/formal-v1/prepare_crypto.py","status":"added","additions":10,"deletions":0,"changes":10,"blob_url":"https://github.com/pipavlo82/verifiable-ai-guarantee-composition/blob/18a5916098addf6447700ed95441125bfa7079c3/research%2Fformal-v1%2Fprepare_crypto.py","raw_url":"https://github.com/pipavlo82/verifiable-ai-guarantee-composition/raw/18a5916098addf6447700ed95441125bfa7079c3/research%2Fformal-v1%2Fprepare_crypto.py","contents_url":"https://api.github.com/repos/pipavlo82/verifiable-ai-guarantee-composition/contents/research%2Fformal-v1%2Fprepare_crypto.py?ref=18a5916098addf6447700ed95441125bfa7079c3","patch":"@@ -0,0 +1,10 @@\n+\"\"\"Stage lockfiles under ignored build/; install commands are explicit and separate.\"\"\"\n+import shutil\n+from pathlib import Path\n+\n+HERE = Path(__file__).resolve().parent\n+OUT = HERE.parents[1] / 'build/formal-v1/crypto'\n+OUT.mkdir(parents=True, exist_ok=True)\n+for name in ('package.json', 'package-lock.json'):\n+    shutil.copyfile(HERE / 'crypto' / name, OUT / name)\n+print('Prepared build/formal-v1/crypto; run npm ci --ignore-scripts there.')"},{"sha":"caa2517d8dce08c282997b7c418e336f4fa996dc","filename":"research/formal-v1/run_mutations.py","status":"added","additions":8,"deletions":0,"changes":8,"blob_url":"https://github.com/pipavlo82/verifiable-ai-guarantee-composition/blob/18a5916098addf6447700ed95441125bfa7079c3/research%2Fformal-v1%2Frun_mutations.py","raw_url":"https://github.com/pipavlo82/verifiable-ai-guarantee-composition/raw/18a5916098addf6447700ed95441125bfa7079c3/research%2Fformal-v1%2Frun_mutations.py","contents_url":"https://api.github.com/repos/pipavlo82/verifiable-ai-guarantee-composition/contents/research%2Fformal-v1%2Frun_mutations.py?ref=18a5916098addf6447700ed95441125bfa7079c3","patch":"@@ -0,0 +1,8 @@\n+import json\n+import sys\n+import mutations\n+\n+report = mutations.run(sys.argv[1], sys.argv[2])\n+sys.stdout.reconfigure(newline='\\n')\n+print(json.dumps(report, indent=2, sort_keys=True))\n+raise SystemExit(0 if report['passed'] else 1)"},{"sha":"819bb30d44f0a472cdd9b05463de5151c8a86416","filename":"research/formal-v1/tests/test_model.py","status":"added","additions":103,"deletions":0,"changes":103,"blob_url":"https://github.com/pipavlo82/verifiable-ai-guarantee-composition/blob/18a5916098addf6447700ed95441125bfa7079c3/research%2Fformal-v1%2Ftests%2Ftest_model.py","raw_url":"https://github.com/pipavlo82/verifiable-ai-guarantee-composition/raw/18a5916098addf6447700ed95441125bfa7079c3/research%2Fformal-v1%2Ftests%2Ftest_model.py","contents_url":"https://api.github.com/repos/pipavlo82/verifiable-ai-guarantee-composition/contents/research%2Fformal-v1%2Ftests%2Ftest_model.py?ref=18a5916098addf6447700ed95441125bfa7079c3","patch":"@@ -0,0 +1,103 @@\n+import importlib.util\n+import sys\n+import unittest\n+from pathlib import Path\n+\n+sys.stdout.reconfigure(newline=\"\\n\")\n+sys.stderr.reconfigure(newline=\"\\n\")\n+ROOT = Path(__file__).resolve().parents[1]\n+spec = importlib.util.spec_from_file_location(\"obligation_model\", ROOT / \"model.py\")\n+model = importlib.util.module_from_spec(spec)\n+spec.loader.exec_module(model)\n+\n+\n+class ObligationTests(unittest.TestCase):\n+    @classmethod\n+    def setUpClass(cls):\n+        cls.report = model.run()\n+\n+    def test_exhaustive_oracle_and_minimal_bases(self):\n+        r = self.report[\"without_cross_component_native_equalities\"]\n+        self.assertEqual((r[\"subsets\"], r[\"assignments\"], r[\"oracle_evaluations\"]), (512, 512, 262144))\n+        self.assertEqual(r[\"sufficient_sets\"], 64)\n+        self.assertEqual(len(r[\"inclusion_minimal_bases\"]), 27)\n+        self.assertEqual(r[\"minimum_cardinality\"], 6)\n+        self.assertEqual(len(r[\"removal_countermodels\"]), 162)\n+\n+    def test_native_premise_changes_minimum(self):\n+        r = self.report[\"conditional_on_one_additional_verified_equality\"]\n+        self.assertEqual((r[\"subsets\"], r[\"assignments\"], r[\"oracle_evaluations\"]), (256, 256, 65536))\n+        self.assertEqual(r[\"sufficient_sets\"], 48)\n+        self.assertEqual(len(r[\"inclusion_minimal_bases\"]), 18)\n+        self.assertEqual(r[\"minimum_cardinality\"], 5)\n+        self.assertEqual(len(r[\"removal_countermodels\"]), 90)\n+\n+    def test_each_removal_satisfies_remaining_and_breaks_target(self):\n+        for key in (\"without_cross_component_native_equalities\", \"conditional_on_one_additional_verified_equality\"):\n+            r = self.report[key]\n+            for cert in r[\"removal_countermodels\"]:\n+                selected = set(cert[\"basis\"]) - {cert[\"removed\"]}\n+                self.assertTrue(model.satisfies_edges(cert[\"countermodel\"], selected | set(r[\"native_premises\"])))\n+                self.assertFalse(model.target_semantics(cert[\"countermodel\"]))\n+                self.assertTrue(model.entails(cert[\"basis\"], r[\"native_premises\"]))\n+\n+    def test_empty_or_one_disconnected_group_cannot_entail(self):\n+        self.assertFalse(model.entails([]))\n+        self.assertFalse(model.entails([k for k in model.EDGES if not k.startswith(\"action.\")]))\n+        self.assertTrue(model.entails(model.EDGES))\n+\n+    def test_unknown_native_fact_rejected(self):\n+        with self.assertRaises(ValueError):\n+            model.entails([], [\"producer_says_verified\"])\n+\n+    def test_algorithm_and_representation_cannot_be_erased(self):\n+        left = {\"algorithm\": \"sha256\", \"representation\": \"raw-bytes-v1\", \"digest\": \"a\" * 64}\n+        self.assertEqual(model.compare_commitments(left, left), \"VERIFIED\")\n+        for changed in ({\"algorithm\": \"keccak256\"}, {\"representation\": \"canonical-value-v1\"}):\n+            right = dict(left, **changed)\n+            self.assertEqual(model.compare_commitments(left, right), \"UNVERIFIABLE\")\n+\n+    def test_missing_unsupported_or_boolean_evidence_cannot_verify(self):\n+        value = {\"algorithm\": \"sha256\", \"representation\": \"raw\", \"digest\": \"a\" * 64}\n+        for other in (None, True, [], \"verified\", {\"verified\": True}, dict(value, digest=True), dict(value, algorithm=[]), dict(value, algorithm=\"other\")):\n+            self.assertEqual(model.compare_commitments(value, other), \"UNVERIFIABLE\")\n+\n+    def test_same_type_digest_contradiction_refuted(self):\n+        value = {\"algorithm\": \"sha256\", \"representation\": \"raw\", \"digest\": \"a\" * 64}\n+        self.assertEqual(model.compare_commitments(value, dict(value, digest=\"b\" * 64)), \"REFUTED\")\n+\n+    def test_noninjective_translation_has_concrete_preimages(self):\n+        r = self.report[\"noninjective_translation_counterexample\"]\n+        self.assertTrue(r[\"normalized_equal\"])\n+        self.assertFalse(r[\"raw_equal\"])\n+        self.assertNotEqual(r[\"left_sha256\"], r[\"right_sha256\"])\n+\n+    def test_no_real_authorization_claim(self):\n+        self.assertEqual(self.report[\"downstream_authorization\"], \"NOT_ESTABLISHED\")\n+        self.assertEqual(self.report[\"cryptographic_verification\"], \"NOT_PERFORMED\")\n+\n+    def test_source_removal_controls(self):\n+        original = (ROOT / \"model.py\").read_text(encoding=\"utf-8\")\n+        sites = [\n+            (\"return all(groups[left] == groups[right] for left, right in TARGETS)\", \"return True\", \"closure\"),\n+            ('if (left[\"algorithm\"], left[\"representation\"]) != (right[\"algorithm\"], right[\"representation\"]):', 'if False:', \"type\")]\n+        for old, new, name in sites:\n+            self.assertEqual(original.count(old), 1)\n+            namespace = {\"__name__\": \"mutant\"}\n+            exec(compile(original.replace(old, new), \"isolated-\" + name, \"exec\"), namespace)\n+            if name == \"closure\":\n+                self.assertFalse(model.entails([]))\n+                self.assertTrue(namespace[\"entails\"]([]))\n+                # The independent exhaustive oracle detects the mutant, not a crash-as-kill.\n+                with self.assertRaisesRegex(RuntimeError, \"Graph closure disagrees\"):\n+                    namespace[\"analyze\"]()\n+            else:\n+                left = {\"algorithm\": \"sha256\", \"representation\": \"raw\", \"digest\": \"a\" * 64}\n+                right = dict(left, representation=\"normalized\")\n+                self.assertEqual(model.compare_commitments(left, right), \"UNVERIFIABLE\")\n+                self.assertEqual(namespace[\"compare_commitments\"](left, right), \"VERIFIED\")\n+            self.assertEqual((ROOT / \"model.py\").read_text(encoding=\"utf-8\"), original)\n+\n+\n+if __name__ == \"__main__\":\n+    unittest.main()"},{"sha":"105a30c45662e0de1a43a4a79f9044fe094a156e","filename":"research/formal-v1/validate.py","status":"added","additions":57,"deletions":0,"changes":57,"blob_url":"https://github.com/pipavlo82/verifiable-ai-guarantee-composition/blob/18a5916098addf6447700ed95441125bfa7079c3/research%2Fformal-v1%2Fvalidate.py","raw_url":"https://github.com/pipavlo82/verifiable-ai-guarantee-composition/raw/18a5916098addf6447700ed95441125bfa7079c3/research%2Fformal-v1%2Fvalidate.py","contents_url":"https://api.github.com/repos/pipavlo82/verifiable-ai-guarantee-composition/contents/research%2Fformal-v1%2Fvalidate.py?ref=18a5916098addf6447700ed95441125bfa7079c3","patch":"@@ -0,0 +1,57 @@\n+\"\"\"Offline replay after locked npm dependencies are installed in build/formal-v1/crypto.\"\"\"\n+import argparse\n+import hashlib\n+import json\n+import platform\n+import re\n+import subprocess\n+import sys\n+from pathlib import Path\n+\n+HERE = Path(__file__).resolve().parent\n+REPO = HERE.parents[1]\n+\n+def main():\n+    parser = argparse.ArgumentParser()\n+    parser.add_argument('--out', default='build/formal-v1/validation')\n+    parser.add_argument('--dependencies', default='build/formal-v1/crypto')\n+    parser.add_argument('--record', action='store_true', help='Record deterministic snapshots for an intentional new research version')\n+    args = parser.parse_args()\n+    out = (REPO / args.out).resolve()\n+    out.mkdir(parents=True, exist_ok=True)\n+    rows = []\n+    def execute(name, command, count=None):\n+        p = subprocess.run(command, cwd=REPO, capture_output=True, timeout=180)\n+        (out / (name + '.stdout.log')).write_bytes(p.stdout)\n+        (out / (name + '.stderr.log')).write_bytes(p.stderr)\n+        row = {'name': name, 'exit': p.returncode, 'stdout_sha256': hashlib.sha256(p.stdout).hexdigest(),\n+               'stderr_sha256': hashlib.sha256(p.stderr).hexdigest(), 'passed': p.returncode == 0}\n+        if count is not None:\n+            matches = re.findall(rb'Ran (\\d+) tests?', p.stderr)\n+            row['tests'] = int(matches[-1]) if matches else 0\n+            row['passed'] = row['passed'] and row['tests'] == count\n+        rows.append(row)\n+        return p.stdout\n+    models = []\n+    for name, optimize in [('normal', []), ('repeat', []), ('optimized', ['-O'])]:\n+        execute('tests-' + name, [sys.executable, '-B', *optimize, '-m', 'unittest', 'discover', '-s', 'research/formal-v1/tests', '-v'], 11)\n+        models.append(execute('model-' + name, [sys.executable, '-B', *optimize, 'research/formal-v1/model.py']))\n+    crypto = [execute('crypto-' + name, ['node', 'research/formal-v1/crypto/check.mjs', args.dependencies]) for name in ('normal', 'repeat')]\n+    mutation = execute('mutations-normal', [sys.executable, '-B', str(HERE / 'run_mutations.py'), args.dependencies, str(out / 'mutants')])\n+    mutation_optimized = execute('mutations-optimized', [sys.executable, '-B', '-O', str(HERE / 'run_mutations.py'), args.dependencies, str(out / 'mutants-optimized')])\n+    snapshots = {'model.json': models[0], 'crypto.json': crypto[0], 'mutations.json': mutation}\n+    if args.record:\n+        for name, data in snapshots.items():\n+            (HERE / 'evidence' / name).write_bytes(data)\n+    committed_matches = {name: (HERE / 'evidence' / name).read_bytes() == data for name, data in snapshots.items()}\n+    deterministic = len(set(models)) == 1 and len(set(crypto)) == 1 and mutation == mutation_optimized\n+    result = {'schema': 'formal-v1-validation', 'python': platform.python_version(),\n+              'node': subprocess.check_output(['node', '--version'], text=True).strip(), 'runs': rows,\n+              'deterministic': deterministic, 'committed_snapshots_match': committed_matches,\n+              'passed': all(r['passed'] for r in rows) and deterministic and all(committed_matches.values())}\n+    (out / 'report.json').write_text(json.dumps(result, indent=2) + '\\n', encoding='utf-8', newline='\\n')\n+    print(json.dumps(result, indent=2))\n+    return 0 if result['passed'] else 1\n+\n+if __name__ == '__main__':\n+    raise SystemExit(main())"}]}