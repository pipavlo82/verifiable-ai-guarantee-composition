-v1/evidence/v0-regression/fixtures-regenerate.stdout.log\": \"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\",\n+    \"research/formal-v1/evidence/v0-regression/mutations-normal.stderr.log\": \"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\",\n+    \"research/formal-v1/evidence/v0-regression/mutations-normal.stdout.json\": \"5287bb25d63b22d315d8b7512d98dd92363588303a541001d6286498817600d2\",\n+    \"research/formal-v1/evidence/v0-regression/mutations-optimized.stderr.log\": \"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\",\n+    \"research/formal-v1/evidence/v0-regression/mutations-optimized.stdout.json\": \"5287bb25d63b22d315d8b7512d98dd92363588303a541001d6286498817600d2\",\n+    \"research/formal-v1/evidence/v0-regression/report.json\": \"5ef8b57357b2f4b176ed989d770246e9813c4246fe56dc0329ce40128ead77a4\",\n+    \"research/formal-v1/evidence/v0-regression/tests-normal.stderr.log\": \"951b99d193f2fd7276f5462753a4ee83ca8a90e7198737b3787af480c30b1422\",\n+    \"research/formal-v1/evidence/v0-regression/tests-normal.stdout.log\": \"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\",\n+    \"research/formal-v1/evidence/v0-regression/tests-optimized.stderr.log\": \"faff5d6cc5717bb6b6b77b38a62fbe2f841a9c6d3d8d5909fa5122c7b97a826c\",\n+    \"research/formal-v1/evidence/v0-regression/tests-optimized.stdout.log\": \"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\",\n+    \"research/formal-v1/evidence/v0-regression/tests-repeat.stderr.log\": \"d48c427edcba61b74eecabfb6fedd70c2a2ffa2a79b754e55ff14bc8c9ce2f61\",\n+    \"research/formal-v1/evidence/v0-regression/tests-repeat.stdout.log\": \"e3b0c44298fc1c149afbf4c8996fb92427ae41e4649b934ca495991b7852b855\",\n+    \"research/formal-v1/model.py\": \"483402e554fa0d1ca4c48364059a9f38711ec44c78bb4b26f568d2ac9b9798f0\",\n+    \"research/formal-v1/mutations.py\": \"ce21250341bbc0fb5b034870c91af3278f8e3bd2829e3dac29d24c6cc7336b38\",\n+    \"research/formal-v1/native_probe.py\": \"c2b70bd5e17723f09122e23c19357ddc23d7b4ab303112ef31a2c4cdd710150b\",\n+    \"research/formal-v1/prepare_crypto.py\": \"04f8591f5bb16c0dfdbb80661f802f4d5fd4cbc4eb1b55df761aed6b060f068b\",\n+    \"research/formal-v1/run_mutations.py\": \"86728f2f41db9a75e7af4b764481cff93fadbbca103255035dd08888d55f279d\",\n+    \"research/formal-v1/tests/test_model.py\": \"9a0e51d67f5032080203ddbe1865ce69f9fd02546226cf2953979609b0c10668\",\n+    \"research/formal-v1/validate.py\": \"ab9bc1934c97fbe18314873c3ac4b96c565b2d72e7a02670ec6be2e5ab5fea59\",\n     \"sources.lock.json\": \"e174867227465ad9d63cec2eb70d90c5823a55425584e96096d7ba57e154ba3f\",\n     \"src/composition.py\": \"6eff12ecf943729f3484c7ed624b26c091d455c5335ecd71c9d8d66ddd7f22dc\",\n     \"tests/test_composition.py\": \"12d1c9efe2bf95840fc5a7f767afc680c3bca68f7b5062e34b74a1e51712d95d\","},{"sha":"6621349506e0a905df800b28e70a6f518f6f881c","filename":"research/formal-v1/BRIDGE_OBLIGATIONS.md","status":"added","additions":24,"deletions":0,"changes":24,"blob_url":"https://github.com/pipavlo82/verifiable-ai-guarantee-composition/blob/18a5916098addf6447700ed95441125bfa7079c3/research%2Fformal-v1%2FBRIDGE_OBLIGATIONS.md","raw_url":"https://github.com/pipavlo82/verifiable-ai-guarantee-composition/raw/18a5916098addf6447700ed95441125bfa7079c3/research%2Fformal-v1%2FBRIDGE_OBLIGATIONS.md","contents_url":"https://api.github.com/repos/pipavlo82/verifiable-ai-guarantee-composition/contents/research%2Fformal-v1%2FBRIDGE_OBLIGATIONS.md?ref=18a5916098addf6447700ed95441125bfa7079c3","patch":"@@ -0,0 +1,24 @@\n+# Native interfaces and missing composition bridges\n+\n+Source versions are frozen in the root [source lock](../../sources.lock.json) and the [additional lock](evidence/additional-sources.json). A normative draft requirement, an implementation observation, a trusted assumption and a proposed research obligation are different evidence categories.\n+\n+| Boundary | Primary interface / source observation | Required additional evidence | Current status |\n+| --- | --- | --- | --- |\n+| Request → WYRIWE | `WyriweAttestation`: agentId, registry, modelHash, rawInputHash, sanitizationPipelineHash, inputHash, outputHash, timestamp | Raw input bytes, sanitization specification/preimages, EIP-712 signature, chain/domain and trusted attestor | NOT IMPLEMENTED for a common tuple |\n+| WYRIWE → tensor input | `rawInputHash` / `inputHash` describe byte commitments; zkIE Store/operation APIs operate on encoded values | Versioned tokenizer/normalizer, tensor layout, quantization and an authenticated transformation relation | NOT IMPLEMENTED |\n+| Model manifest → proof | WYRIWE `modelHash` can identify weights or a manifest; zkIE committed projection uses weight commitments | An explicit manifest-to-tensor/commitment mapping including shapes, operator graph and encoding | NOT IMPLEMENTED |\n+| Proof → inference claim | zkIE `OpShardProof`, `ShardDagProof`, `verify_shard`, `verify_shard_dag` | A serialized proof/statement interface and exact public statement for the target claim | Two native library tests executed; portable export not implemented |\n+| Inference output → proposal | Native output values and a judgment's `rawProposalHash` are different objects | Deterministic versioned action construction or another verified conformance relation | NOT IMPLEMENTED |\n+| Verdict → proposal | Public Nostr content carries `artifact_hash`; the draft also defines `verdictHash` constructions | Correct signature, exact signed bytes, proposal preimage/encoding, declared hash profile | Signature and same-profile digest relation checked; preimage unchecked |\n+| Signer → authority | A public key identifies a signing key, not policy entitlement | Caller-trusted key/identity mapping and policy granting this signer authority for this action | UNVERIFIABLE |\n+| Judgment → execution | Nine-field `JudgmentExecutionAttestation` includes validator, proposal/verdict/action hashes, two timestamps and recordPointer | Executing-agent signature, validator artifact, and proposal/execution conformance evidence | NOT IMPLEMENTED |\n+| Execution → receipt | ReceiptOS request/bundle schemas and `receiptos.verify.generic.v2` are source-observed interfaces | A genuine receipt for that execution, exact subject, profile, trust configuration and dependencies | NOT IMPLEMENTED |\n+| Receipt → downstream claim | A receipt attests to its declared verification result and subject | An explicit policy rule whose predicates follow from those exact facts | NOT IMPLEMENTED |\n+| Context / replay | Chain, verifier, policy and timing can constrain applicability | Authenticated context, pinned policy content and an actual freshness/replay mechanism | NOT IMPLEMENTED; a signed timestamp alone is insufficient |\n+| Algorithm / representation | Off-chain SHA-256/JCS and on-chain Keccak/ABI are distinct profiles | Declared algorithms, canonical bytes and a verifiable cross-profile relation | Research type checks only; no automatic bridge |\n+\n+Primary references: [zkIE compose.rs](https://github.com/trustless-ai/zkIE/blob/39d8df96877bc3bebf33c69b06907d792b3184b9/crates/zkie-ops/src/compose.rs), [WYRIWE interface](https://github.com/trustless-ai/agent-ercs/blob/01283ca57305f915afb560d23359a27fd748eb5a/contracts/verify/ERC8299/IWyriweAttestation.sol), [judgment interface](https://github.com/trustless-ai/agent-ercs/blob/01283ca57305f915afb560d23359a27fd748eb5a/contracts/verify/ERC8299/IJudgmentExecutionAttestation.sol), [ReceiptOS schema](https://github.com/pipavlo82/receiptos-verify/blob/396143120f787d2f5534e92c0cf896c029a05775/schemas/request-v2.schema.json).\n+\n+The draft's optional verifier/policy commitments must not be retroactively inserted into the semantics of older signed artifacts. A legacy object can authenticate its original content while leaving a newer consumer's obligation UNVERIFIABLE. The draft and interface also contain different wording about verdict-time freezing versus reveal-time signing; a future profile must resolve the precise signing event rather than silently choosing a favorable interpretation.\n+\n+No adapters or source changes were made to upstream repositories. The present Node replay is our narrow consumer of a public Nostr event, not a WYRIWE EIP-712 verifier or a ReceiptOS adapter."},{"sha":"09946fe9092abcd6063e6a57ac6fe2fc10ef00d6","filename":"research/formal-v1/FORMAL_MODEL.md","status":"added","additions":49,"deletions":0,"changes":49,"blob_url":"https://github.com/pipavlo82/verifiable-ai-guarantee-composition/blob/18a5916098addf6447700ed95441125bfa7079c3/research%2Fformal-v1%2FFORMAL_MODEL.md","raw_url":"https://github.com/pipavlo82/verifiable-ai-guarantee-composition/raw/18a5916098addf6447700ed95441125bfa7079c3/research%2Fformal-v1%2FFORMAL_MODEL.md","contents_url":"https://api.github.com/repos/pipavlo82/verifiable-ai-guarantee-composition/contents/research%2Fformal-v1%2FFORMAL_MODEL.md?ref=18a5916098addf6447700ed95441125bfa7079c3","patch":"@@ -0,0 +1,49 @@\n+# A conditional model of binding obligations\n+\n+## Typed facts, rather than a scalar assurance score\n+\n+Represent a verified fact as `(predicate, subjects, representation, scope, authority, evidence, dependencies, assumptions)`. Examples are `Authentic(signer, bytes)`, `Proves(verifier_profile, statement, proof)`, `Derived(transform, raw, normalized)`, `Conforms(policy, proposal, execution)` and `Permitted(policy, requester, action, context)`.\n+\n+These predicates are not ordered by one generic strength number. A signature, an inference proof and a judgment establish different facts. In particular, authentication does not entail truth, permission or physical execution. A rule may use a fact only with its declared type and assumptions.\n+\n+The G1-G8 obligations in [v0](../GUARANTEE_MODEL.md) remain separate. V1 studies the equality/representation part of their composition. It does not implement all eight guarantees for real artifacts.\n+\n+For each applicable obligation use `VERIFIED`, `REFUTED` or `UNVERIFIABLE`. A checked contradiction is REFUTED. Missing evidence, unsupported representation or an unavailable native verifier is UNVERIFIABLE. Refuse authorization unless every required obligation is VERIFIED. A refusal does not establish maliciousness or falsehood. For an overall conjunction, a verified contradiction can refute the conjunction even if other dependencies are unknown.\n+\n+## Exact abstract scope\n+\n+There are nine subject variables in three groups:\n+\n+| Dimension | Variables | Target |\n+| --- | --- | --- |\n+| input | requested_input, provenance_input, inference_input | All three equal |\n+| model | requested_model, provenance_model, inference_model | All three equal |\n+| action | requested_action, judged_action, executed_action | All three equal |\n+\n+Each group offers its three pairwise equality checks: RP (first/second), PI (second/third), RI (first/third). These are **abstract identifiers in a common representation**, not literal upstream bytes. In particular, a proposed action and an execution record normally differ. Applying the action equality model requires an independently justified projection/conformance relation; no such bridge is supplied by the toy graph.\n+\n+Let E be the nine candidate edges, N a set of trusted native equalities, S a subset of E minus N, and T the six requested-to-other target equalities. Native facts are explicit hypotheses. A producer's `verified=true` is not a fact in N. All node domains contain at least two elements.\n+\n+## Equality-closure proposition (standard result, no novelty claim)\n+\n+`N ∪ S` entails every equality in T if and only if both endpoints of each target are connected in the undirected graph `(variables, N ∪ S)`.\n+\n+Proof: a connecting path entails equality by transitivity. Conversely, if a target's endpoints are disconnected, assign value 1 to the component of one endpoint and 0 to all other components. Every selected/native equality holds, while that target fails. This supplies a concrete two-valued countermodel. The argument works over any domain with at least two distinct values; finite enumeration checks our implementation, not the general proof.\n+\n+In this particular target graph, after contracting N, inclusion-minimal sufficient sets form trees connecting each required group. The implementation independently checks all binary assignments using direct three-way equality rather than graph traversal.\n+\n+Without native cross-component equalities, each triangle has three spanning trees with two edges. Therefore there are `3^3 = 27` bases of six edges. Adding the hypothetical native equality `model.PI` leaves two choices to connect the requested model: `3 × 2 × 3 = 18` bases of five added edges. In these instances all inclusion-minimal bases also have minimum cardinality; this coincidence must not be generalized to arbitrary policies or weighted checks.\n+\n+Every single-edge removal from every basis has a saved countermodel: 162 and 90 respectively. The exhaustive comparisons examine 512 × 512 and 256 × 256 compatible assignment/subset pairs. No claim is made that six checks suffice for a real AI system. Sound native verification, authority, policy, representation, freshness and receipt semantics are outside this graph and are necessary additional premises.\n+\n+## Representation boundary\n+\n+A commitment is identified by `(algorithm, representation, digest)`, not digest bytes alone. Unlike representations are UNVERIFIABLE without a verified bridge. The reference comparator only compares these research records; it neither computes Keccak nor authenticates their labels.\n+\n+The concrete preimages `b\"3\"` and `b\"003\"` both normalize to integer 3 but have different raw hashes. Thus equality of normalized model inputs cannot prove equality of submitted byte strings. A downstream claim must specify whether it concerns raw bytes, normalized values, tensors or action conformance. This is a standard non-injectivity argument, not a hash collision.\n+\n+## Full composition rule: candidate profile, not an implemented theorem about upstreams\n+\n+For a fixed policy P and claim C, require: sound native verification of each typed predicate; authenticated and available subjects; verified representation/transform/conformance bridges; applicable authority and scope; time/replay constraints; and a derivation of C from those exact premises under P. Only then may C be marked VERIFIED.\n+\n+The proposition above handles the equality subproblem. Proving that real profiles discharge the remaining premises, and that their concrete verifier implementations implement this rule, is future work. No end-to-end composition theorem for zkIE/WYRIWE/ReceiptOS is asserted here."},{"sha":"9be00193a88222e8c70b92cb32491d75485a59a8","filename":"research/formal-v1/NOVELTY_REVIEW.md","status":"added","additions":32,"deletions":0,"changes":32,"blob_url":"https://github.com/pipavlo82/verifiable-ai-guarantee-composition/blob/18a5916098addf6447700ed95441125bfa7079c3/research%2Fformal-v1%2FNOVELTY_REVIEW.md","raw_url":"https://github.com/pipavlo82/verifiable-ai-guarantee-composition/raw/18a5916098addf6447700ed95441125bfa7079c3/research%2Fformal-v1%2FNOVELTY_REVIEW.md","contents_url":"https://api.github.com/repos/pipavlo82/verifiable-ai-guarantee-composition/contents/research%2Fformal-v1%2FNOVELTY_REVIEW.md?ref=18a5916098addf6447700ed95441125bfa7079c3","patch":"@@ -0,0 +1,32 @@\n+# Bounded prior-art review and candidate contribution\n+\n+**Conclusion: scientific novelty is not yet established.** The current contribution is a reproducible research instrument, a source-specific obligations map, and small executed examples. The literature sample below is targeted, not an exhaustive priority or patent search. Exact captured bytes, retrieval times and hashes are in [captures.json](evidence/captures.json); full papers remain local reference material rather than copied source in this repository.\n+\n+| Primary source | Relevant established idea | Consequence for our claim |\n+| --- | --- | --- |\n+| [Chilton, Jonsson and Kwiatkowska, 2014](https://qav.cs.ox.ac.uk/papers/CJK14.pdf), assume-guarantee reasoning for compositional component theories | Formal reasoning about local contracts and their composition | We cannot claim the first theory of composing guarantees |\n+| [A Proof-Carrying Authorization System, Princeton TR-638-01](https://www.cs.princeton.edu/techreports/2001/638.pdf) | Authorization justified by proofs against policy | Proof validity and permission are already distinct obligations |\n+| [RFC 9334, RATS Architecture](https://www.rfc-editor.org/rfc/rfc9334.html), especially appraisal and relying-party roles | Attestation evidence is appraised; a relying party makes decisions under its own policy | Authentic attestation alone is not a new theory of authorization |\n+| [AEX, arXiv:2603.14283v1](https://arxiv.org/html/2603.14283v1) | Signed AI exchange bindings and explicit transformation/binding modes | Portable request/output evidence and representation boundaries have close prior art |\n+| [Composable Attestation, arXiv:2603.02451v1](https://arxiv.org/html/2603.02451v1) | Attestation composition for AI/distributed workflows | A broad claim of first composable AI attestation would be unjustified |\n+| [Agent Action Capsule Provenance Binding, draft-00](https://www.ietf.org/archive/id/draft-rampalli-scitt-capsule-provenance-binding-00.txt) | Per-action authorization bound to provenance; separates permission, execution and justification | Combining these categories is not by itself a new contribution; this source is a draft, not an adopted RFC |\n+| [Pinned ERC-8299 draft](https://github.com/ethereum/ERCs/blob/c0e13d17940a6eabe4d842e623fd0f871550ef7b/ERCS/erc-8299.md) and [judgment interface](https://github.com/trustless-ai/agent-ercs/blob/01283ca57305f915afb560d23359a27fd748eb5a/contracts/verify/ERC8299/IJudgmentExecutionAttestation.sol) | Judgment authenticity does not imply soundness or permission; proposal and execution binding are explicit concerns | These distinctions must be credited to upstream rather than presented as an omission we discovered |\n+\n+## What could become a defensible contribution\n+\n+For an exact, versioned combination of native verifiers and downstream policy, derive the additional cross-artifact obligations that remain after the native checks. Make representations and transformations explicit. Give conditional sufficiency arguments and a counterexample for each necessary obligation. Then exercise those obligations against a genuine coherent chain, using identical inputs for component-only and composition-aware consumers.\n+\n+The proposed distinction is the **measured residual obligations for specific profiles**, not a new cryptographic primitive or generic statement that composition can fail. This stage does not establish that prior work lacks such a method. That requires a deeper comparison and independent review.\n+\n+The graph model provides an inspectable method but its connectivity/minimality facts are elementary. The signed-event substitution control is a familiar authentication-versus-context example. The public event and local zkIE tests are unrelated and cannot jointly support a real end-to-end result.\n+\n+## Acceptance gates\n+\n+1. Define one real target claim and its exact authority/policy/representation profile.\n+2. Obtain one coherent tuple with proof, preimages, attestation, verdict, execution evidence and receipt.\n+3. Identify which relations native verification already establishes, with executable evidence.\n+4. Derive remaining obligations and test necessity without changing the native valid components.\n+5. Compare against a well-specified baseline on the same tuple; report unknowns and costs without generalizing from one case.\n+6. Seek independent reproduction and specialist review before broader novelty or security claims.\n+\n+Recommendation: CONTINUE this narrow experiment; HOLD priority claims and upstream vulnerability claims."},{"sha":"cca1e3bc7c5f536cb817e61f30247d63b7873120","filename":"research/formal-v1/PAPER_OUTLINE.md","status":"added","additions":15,"deletions":0,"changes":15,"blob_url":"https://github.com/pipavlo82/verifiable-ai-guarantee-composition/blob/18a5916098addf6447700ed95441125bfa7079c3/research%2Fformal-v1%2FPAPER_OUTLINE.md","raw_url":"https://github.com/pipavlo82/verifiable-ai-guarantee-composition/raw/18a5916098addf6447700ed95441125bfa7079c3/research%2Fformal-v1%2FPAPER_OUTLINE.md","contents_url":"https://api.github.com/repos/pipavlo82/verifiable-ai-guarantee-composition/contents/research%2Fformal-v1%2FPAPER_OUTLINE.md?ref=18a5916098addf6447700ed95441125bfa7079c3","patch":"@@ -0,0 +1,15 @@\n+# Revised paper outline: candidate research, not a priority claim\n+\n+1. **Abstract.** State the specific composition question, exact experimental scope and incomplete real integration. Report reproducible observations without claiming an upstream vulnerability.\n+2. **Problem statement.** Determine the additional obligations required to authorize a particular downstream claim after native components verify.\n+3. **Related work.** Assume-guarantee reasoning, proof-carrying authorization, RATS, AEX, composable attestation, action capsules and the pinned upstream drafts. Explain overlaps before proposing a distinction.\n+4. **Formal definitions.** Typed facts, evidence scopes, native premises, representation bridges, authority policy and tri-state results. Separate equality of identifiers from action conformance.\n+5. **Threat model.** A consumer receives authentic but unrelated objects, unavailable dependencies or incompatible representations; cryptographic primitives are assumed sound. Honest upstream rejection is not an attack result.\n+6. **Established lemma and theorem candidates.** Give the standard equality-closure proof. State the full application-specific composition rule conditionally; do not promote unmet premises to a theorem about deployed software.\n+7. **Counterexamples.** Every removed abstract equality has a witness; normalization is non-injective; a genuine signature survives a changed consumer request while binding fails.\n+8. **Methodology.** Pinned sources, independent finite oracle, source mutations with crash separation, native test execution, locked-library signature replay, deterministic outputs and fresh-checkout verification.\n+9. **Results.** Distinguish v0 synthetic baseline, v1 abstract enumeration, four implementation mutations, public event verification and two native library tests. No single combined end-to-end success rate.\n+10. **Limitations.** Toy graph, conditional authority, no coherent tuple, no portable zkIE proof capture, no EIP-712/receipt integration, bounded prior-art coverage and no cryptographic audit.\n+11. **Future work.** A real common-subject tuple, executable representation/conformance bridges, stronger baselines, broader case coverage and independent reproduction/review.\n+\n+The scientific contribution remains a hypothesis until the profile-specific analysis and real coherent experiment distinguish it from prior work."},{"sha":"feab252c911cf7fcf2705dcb1e269fed3b1b99c5","filename":"research/formal-v1/README.md","status":"added","additions":55,"deletions":0,"changes":55,"blob_url":"https://github.com/pipavlo82/verifiable-ai-guarantee-composition/blob/18a5916098addf6447700ed95441125bfa7079c3/research%2Fformal-v1%2FREADME.md","raw_url":"https://github.com/pipavlo82/verifiable-ai-guarantee-composition/raw/18a5916098addf6447700ed95441125bfa7079c3/research%2Fformal-v1%2FREADME.md","contents_url":"https://api.github.com/repos/pipavlo82/verifiable-ai-guarantee-composition/contents/research%2Fformal-v1%2FREADME.md?ref=18a5916098addf6447700ed95441125bfa7079c3","patch":"@@ -0,0 +1,55 @@\n+# Typed composition obligations: research stage v1\n+\n+This stage narrows the candidate contribution to **profile-specific, representation-aware binding obligations** across separately verified artifacts. Scientific novelty is **NOT ESTABLISHED**. Equality closure, assume-guarantee reasoning and the separation of authentication from authorization are established ideas.\n+\n+This is independent research, not an official Trustless AI specification, security certification or upstream vulnerability report.\n+\n+## What was actually executed\n+\n+| Experiment | Observed result | What it establishes |\n+| --- | --- | --- |\n+| Abstract equality model, no native cross-component equalities | 27 inclusion-minimal bases, all size 6; 162 removal countermodels | Necessary and sufficient equality checks within the declared model |\n+| Same model, one **hypothetically established** native equality | 18 inclusion-minimal bases, all size 5; 90 removal countermodels | The minimum depends on native premises, not a universal checklist |\n+| Independent exhaustive oracle | 327,680 assignment/subset pairs, agreement with graph closure | Finite implementation cross-check; the general equality lemma has a separate proof |\n+| New Python suite | 11 tests in normal, repeat and `-O` modes | Research model and boundary controls |\n+| Public signed Nostr event | 11 checks, repeated; original BIP-340 signature verifies | Authenticity under the embedded public key and a narrow proposal-digest binding |\n+| New source mutations | 4 KILLED; 0 SURVIVED/CRASHED/NOT_APPLIED/UNVERIFIABLE; restoration passes | Four specific enforcement checks affect their intended negative controls |\n+| Pinned native zkIE tests | 2 exact tests pass online and in offline replay | Native proving/verification test routines execute, including their substitution checks |\n+| Unchanged v0 regression | 19 tests in normal/repeat/optimized modes; original results reproduce | Existing synthetic experiment preserved |\n+\n+The 252 abstract countermodels are **not 252 implementation mutations**. The native tests and public event concern different subjects; they are not a composed real execution. Full WYRIWE EIP-712 verification, proof export, execution receipts and downstream authorization remain **NOT IMPLEMENTED** for a common tuple. The legacy v0 baseline numbers remain synthetic and are not generalized to real deployments.\n+\n+An initial local v0 regression attempt encountered a Windows sandbox temporary-directory permission error. The unchanged suite passed when rerun with approved access. The failed attempt remains in the local delivery; `evidence/v0-regression/` records the successful run. CI repeats v0 separately and does not run the optional native zkIE Cargo tests.\n+\n+Read [novelty review](NOVELTY_REVIEW.md), [formal model](FORMAL_MODEL.md), [bridge obligations](BRIDGE_OBLIGATIONS.md), [artifact status](REAL_ARTIFACT_STATUS.md), and [paper revision](PAPER_OUTLINE.md). Machine-readable deterministic evidence is in [evidence](evidence/); the validation reports distinguish executed checks from captured producer statements.\n+\n+## Reproduce from the repository root\n+\n+Python 3.12+ and Node 22.15+ are used. Python has no external dependencies. Node uses MIT-licensed `@noble/curves@2.0.1` and `@noble/hashes@2.0.1`, pinned with npm integrity digests. No upstream source is copied into our implementation.\n+\n+```sh\n+python -B research/formal-v1/prepare_crypto.py\n+npm ci --ignore-scripts --no-audit --no-fund --prefix build/formal-v1/crypto\n+python -B research/formal-v1/validate.py\n+python -B tools/validate.py --out build/v0-regression\n+python -B tools/verify_artifacts.py\n+```\n+\n+After the first dependency installation, the verifier itself is fully offline. A fresh install from a populated npm cache can add `--offline`. Determinism means byte equality of model, signature-check and mutation reports; timing-bearing unittest/native logs are not expected to be byte-identical.\n+\n+Native zkIE replay is a separate, more expensive check:\n+\n+```sh\n+git clone https://github.com/trustless-ai/zkIE.git build/zkIE\n+git -C build/zkIE checkout 39d8df96877bc3bebf33c69b06907d792b3184b9\n+python -B research/formal-v1/native_probe.py --zkie-clone build/zkIE --cache-dir build/native-cache --out build/native-online --online\n+python -B research/formal-v1/native_probe.py --zkie-clone build/zkIE --cache-dir build/native-cache --out build/native-offline\n+```\n+\n+The runner requires a clean pinned checkout and `--locked` Cargo dependencies. It checks that exactly the intended test ran, not merely a zero exit from an empty test filter. Local evidence uses Rust/Cargo 1.97.1. Library tests use upstream testing parameters and deterministic test randomness; this is not a production cryptographic security assessment.\n+\n+## Version boundary\n+\n+Frozen v0 is commit `905767f8696afe4cee612c8248f9d5d76f81f81b`. This branch adds `research/formal-v1/` and its own workflow. Only the root SHA-256 inventory is intentionally expanded among existing files. Original v0 code, fixtures, documentation and evidence remain byte-identical; its `NOT IMPLEMENTED` statements describe that frozen version. New observations are recorded here without retroactively attributing them to v0. Main remains unchanged.\n+\n+Recommendation: **CONTINUE**, with a coherent real artifact tuple and independent review as the next acceptance gate. Hold any claim of demonstrated scientific novelty, end-to-end verification or upstream vulnerability."},{"sha":"05c9c9f2773d7557a5e812605a94f7632c42cd20","filename":"research/formal-v1/REAL_ARTIFACT_STATUS.md","status":"added","additions":35,"deletions":0,"changes":35,"blob_url":"https://github.com/pipavlo82/verifiable-ai-guarantee-composition/blob/18a5916098addf6447700ed95441125bfa7079c3/research%2Fformal-v1%2FREAL_ARTIFACT_STATUS.md","raw_url":"https://github.com/pipavlo82/verifiable-ai-guarantee-composition/raw/18a5916098addf6447700ed95441125bfa7079c3/research%2Fformal-v1%2FREAL_ARTIFACT_STATUS.md","contents_url":"https://api.github.com/repos/pipavlo82/verifiable-ai-guarantee-composition/contents/research%2Fformal-v1%2FREAL_ARTIFACT_STATUS.md?ref=18a5916098addf6447700ed95441125bfa7079c3","patch":"@@ -0,0 +1,35 @@\n+# Real artifact status and evidence boundaries\n+\n+## Executed independently\n+\n+At zkIE commit `39d8df96877bc3bebf33c69b06907d792b3184b9`, both exact tests passed:\n+\n+- `compose::tests::op_shard_matmul_roundtrip`\n+- `compose::tests::committed_projection_roundtrip`\n+\n+They execute the upstream native proof/verification routines. Their test bodies include changed-input or changed-weight rejection controls. They use upstream test parameters and deterministic test randomness. We did not audit cryptographic soundness, run a full inference model, export a portable proof, or attach these proofs to a real external attestation.\n+\n+The initial offline attempt failed because the isolated Cargo cache lacked dependencies. That failure is preserved in `evidence/native/offline-*`. Online dependency installation with `--locked` then succeeded, followed by offline replay. The original reports and raw logs are preserved, together with a replay using the portable runner. Upstream tracked files stayed clean.\n+\n+The public event extracted from [ledger 19](https://api.babyblueviper.com/ledger/19) has ID `ff7227c605828f94457f450bc44b4c1dbc11e8f6df27f38f55a4aeb75d0b284a`. We independently recompute the [NIP-01](https://github.com/nostr-protocol/nips/blob/a79e21d90fce5465b50ef385dd368bba99ec4a0b/01.md) event ID from the original content string and verify its [BIP-340](https://github.com/bitcoin/bips/blob/927b6de9915c9262615a6399de51b200f81e5aa4/bip-0340.mediawiki) signature using locked `@noble/curves@2.0.1`. No signing keys, new signatures or server-side verification endpoints are used.\n+\n+The original verifies. Corrupting the signature, content, ID or key fails. Changed content with a recomputed event ID also fails under the original signature. Keeping the genuine signed event unchanged while substituting the consumer's requested proposal digest leaves authenticity VERIFIED and makes the digest binding REFUTED. This is a controlled consumer test, not evidence that the upstream service accepts the substitution.\n+\n+## Scope of the verified public signature\n+\n+The signature authenticates the event content under its embedded public key. It does not establish who controls that key, who authorized it, whether the judgment is correct, trusted issuance time, relay inclusion, chain execution, or downstream permission. The signed `artifact_hash` can be compared to a caller-supplied digest under an assumed common profile; the proposal preimage is not verified in this stage.\n+\n+The API's surrounding execution, transaction, timestamp and outcome fields are producer-reported data. We did not verify them with chain/relay inclusion proofs, nor infer their authenticity from a signature over a different nested object. The signed content does not contain the surrounding `executed_action_hash`. The source already limits its timestamp/anchor claims; we do not upgrade them.\n+\n+The extracted JSON is not advertised as raw HTTP bytes. Its provenance file records the complete response's SHA-256; raw response snapshots remain in the local evidence delivery. The capture manifest's `signature_verification: NOT_PERFORMED` describes capture-time behavior. `evidence/crypto.json` records the subsequent independent offline verification.\n+\n+## Next coherent experiment\n+\n+1. Obtain or generate an authorized real inference with retained input bytes, model manifest, native proof and public statement.\n+2. Obtain a real attestation covering the same input/model/output, including canonicalization and signature domain.\n+3. Obtain a judgment covering the exact proposed action, with an independently configured authority policy.\n+4. Retain real execution evidence and a receipt for that same execution; verify the transform from proposal to execution.\n+5. Publish only shareable artifacts, with source locks and exact byte commitments. Independently replay the native verifiers and composition rules.\n+6. Use valid but unrelated components for controlled substitutions; compare consumers on identical inputs and explicitly classify missing evidence.\n+\n+End-to-end integration remains NOT IMPLEMENTED. No fabricated proof, signature, transaction, receipt or retrospective policy field fills a missing link. The local native tests and this public event must not be stitched together into a purported execution chain."},{"sha":"d134a6eaf5503e3f324494677e0d1072635dfbb5","filename":"research/formal-v1/crypto/check.mjs","status":"added","additions":74,"deletions":0,"changes":74,"blob_url":"https://github.com/pipavlo82/verifiable-ai-guarantee-composition/blob/18a5916098addf6447700ed95441125bfa7079c3/research%2Fformal-v1%2Fcrypto%2Fcheck.mjs","raw_url":"https://github.com/pipavlo82/verifiable-ai-guarantee-composition/raw/18a5916098addf6447700ed95441125bfa7079c3/research%2Fformal-v1%2Fcrypto%2Fcheck.mjs","contents_url":"https://api.github.com/repos/pipavlo82/verifiable-ai-guarantee-composition/contents/research%2Fformal-v1%2Fcrypto%2Fcheck.mjs?ref=18a5916098addf6447700ed95441125bfa7079c3","patch":"@@ -0,0 +1,74 @@\n+// Narrow offline replay of an existing public event, not an authorization service.\n+import { createHash } from 'node:crypto';\n+import { readFileSync } from 'node:fs';\n+import { resolve } from 'node:path';\n+import { pathToFileURL } from 'node:url';\n+const dependencyRoot = process.argv[2];\n+if (!dependencyRoot) throw new Error('Pass the isolated npm install directory');\n+const { schnorr } = await import(pathToFileURL(resolve(dependencyRoot, 'node_modules/@noble/curves/secp256k1.js')));\n+const event = JSON.parse(readFileSync(new URL('./ledger-19-event.json', import.meta.url), 'utf8'));\n+const hex = (s, n) => typeof s === 'string' && new RegExp(`^[0-9a-f]{${n}}$`).test(s);\n+const sha256 = data => createHash('sha256').update(data).digest('hex');\n+\n+function authenticate(e) {\n+  if (!e || !hex(e.pubkey, 64) || !hex(e.id, 64) || !hex(e.sig, 128)\n+      || !Number.isSafeInteger(e.created_at) || e.created_at < 0\n+      || !Number.isSafeInteger(e.kind) || e.kind < 0 || e.kind > 65535\n+      || typeof e.content !== 'string' || !Array.isArray(e.tags)\n+      || !e.tags.every(t => Array.isArray(t) && t.every(x => typeof x === 'string'))) return 'UNVERIFIABLE';\n+  const id = sha256(JSON.stringify([0, e.pubkey, e.created_at, e.kind, e.tags, e.content]));\n+  if (id !== e.id) return 'REFUTED';\n+  try {\n+    return schnorr.verify(Buffer.from(e.sig, 'hex'), Buffer.from(id, 'hex'), Buffer.from(e.pubkey, 'hex')) ? 'VERIFIED' : 'REFUTED';\n+  } catch { return 'REFUTED'; }\n+}\n+\n+function proposalBinding(e, requestedDigest) {\n+  const authentic = authenticate(e);\n+  if (authentic !== 'VERIFIED') return authentic;\n+  if (!hex(requestedDigest, 64)) return 'UNVERIFIABLE';\n+  let content;\n+  try { content = JSON.parse(e.content); } catch { return 'UNVERIFIABLE'; }\n+  if (!content || content.schema !== 'invinoveritas.verdict_proof.v1'\n+      || !hex(content.artifact_hash, 64) || content.verifier_pubkey !== e.pubkey) return 'UNVERIFIABLE';\n+  // A same-profile digest comparison only. Caller must establish preimage and encoding.\n+  return content.artifact_hash === requestedDigest ? 'VERIFIED' : 'REFUTED';\n+}\n+\n+const content = JSON.parse(event.content);\n+const originalBytes = JSON.stringify(event);\n+const flip = s => (s[0] === '0' ? '1' : '0') + s.slice(1);\n+const changedSignature = { ...event, sig: flip(event.sig) };\n+const changedContent = { ...event, content: event.content + ' ' };\n+const changedKey = { ...event, pubkey: flip(event.pubkey) };\n+const changedId = { ...event, id: flip(event.id) };\n+const changedContentWithId = { ...changedContent, id: sha256(JSON.stringify([0, changedContent.pubkey, changedContent.created_at, changedContent.kind, changedContent.tags, changedContent.content])) };\n+const cases = [\n+  ['original_signature', authenticate(event), 'VERIFIED'],\n+  ['changed_signature', authenticate(changedSignature), 'REFUTED'],\n+  ['changed_content_stale_id', authenticate(changedContent), 'REFUTED'],\n+  ['changed_content_recomputed_id_original_signature', authenticate(changedContentWithId), 'REFUTED'],\n+  ['changed_key', authenticate(changedKey), 'REFUTED'],\n+  ['changed_id', authenticate(changedId), 'REFUTED'],\n+  ['matching_proposal_digest', proposalBinding(event, content.artifact_hash), 'VERIFIED'],\n+  ['wrong_proposal_same_authentic_event', proposalBinding(event, flip(content.artifact_hash)), 'REFUTED'],\n+  ['missing_proposal', proposalBinding(event, undefined), 'UNVERIFIABLE'],\n+  ['boolean_is_not_evidence', authenticate({ verified: true }), 'UNVERIFIABLE'],\n+  ['original_event_still_authentic', authenticate(event), 'VERIFIED'],\n+];\n+const report = {\n+  schema: 'public-nostr-replay-v1', mode: 'REAL_PUBLIC_SIGNATURE_WITH_CONTROLLED_CONSUMER_SUBSTITUTIONS',\n+  event_id: event.id, pubkey: event.pubkey, signature_algorithm: 'BIP340/secp256k1',\n+  dependency: '@noble/curves@2.0.1',\n+  cases: cases.map(([name, actual, expected]) => ({ name, actual, expected, passed: actual === expected })),\n+  original_event_unchanged: originalBytes === JSON.stringify(event),\n+  wrong_subject_control: { component_authenticity: authenticate(event), request_binding: proposalBinding(event, flip(content.artifact_hash)) },\n+  boundaries: {\n+    signer_identity: 'UNVERIFIABLE', signer_authority: 'UNVERIFIABLE', proposal_preimage: 'NOT_CHECKED',\n+    trusted_time: 'UNVERIFIABLE', relay_or_chain_inclusion: 'NOT_CHECKED', execution: 'NOT_CHECKED',\n+    wyriwe_eip712_attestation: 'NOT_CHECKED', zkie_link: 'NOT_IMPLEMENTED', downstream_authorization: 'UNVERIFIABLE'\n+  }\n+};\n+report.passed = report.cases.every(c => c.passed) && report.original_event_unchanged;\n+process.stdout.write(JSON.stringify(report, null, 2) + '\\n');\n+if (!report.passed) process.exitCode = 1;"},{"sha":"2f8e742f35ef0572c69378720e