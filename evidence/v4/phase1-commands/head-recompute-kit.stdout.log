github.com/users/web-flow/gists{/gist_id}","starred_url":"https://api.github.com/users/web-flow/starred{/owner}{/repo}","subscriptions_url":"https://api.github.com/users/web-flow/subscriptions","organizations_url":"https://api.github.com/users/web-flow/orgs","repos_url":"https://api.github.com/users/web-flow/repos","events_url":"https://api.github.com/users/web-flow/events{/privacy}","received_events_url":"https://api.github.com/users/web-flow/received_events","type":"User","user_view_type":"public","site_admin":false},"parents":[{"sha":"9ec72abccc572a1015e9df08149f11f160d2bc8a","url":"https://api.github.com/repos/trustless-ai/recompute-kit/commits/9ec72abccc572a1015e9df08149f11f160d2bc8a","html_url":"https://github.com/trustless-ai/recompute-kit/commit/9ec72abccc572a1015e9df08149f11f160d2bc8a"},{"sha":"dbfe40f62a4193ddc76f8f3d26e3c0355c9409d3","url":"https://api.github.com/repos/trustless-ai/recompute-kit/commits/dbfe40f62a4193ddc76f8f3d26e3c0355c9409d3","html_url":"https://github.com/trustless-ai/recompute-kit/commit/dbfe40f62a4193ddc76f8f3d26e3c0355c9409d3"}],"stats":{"total":154,"additions":149,"deletions":5},"files":[{"sha":"0f7e66975fc9aaf1e539d8417fe7a6faa278773a","filename":".github/workflows/conformance.yml","status":"modified","additions":1,"deletions":0,"changes":1,"blob_url":"https://github.com/trustless-ai/recompute-kit/blob/f7308cdd5ba55ac8229103e82ebc5fc14f81b88b/.github%2Fworkflows%2Fconformance.yml","raw_url":"https://github.com/trustless-ai/recompute-kit/raw/f7308cdd5ba55ac8229103e82ebc5fc14f81b88b/.github%2Fworkflows%2Fconformance.yml","contents_url":"https://api.github.com/repos/trustless-ai/recompute-kit/contents/.github%2Fworkflows%2Fconformance.yml?ref=f7308cdd5ba55ac8229103e82ebc5fc14f81b88b","patch":"@@ -84,6 +84,7 @@ jobs:\n           python3 tools/test_run_conformance_live_lifecycle.py\n           python3 tools/test_run_conformance_runtime_preconditions.py\n           python3 tools/test_run_conformance_stale_declarations.py\n+          python3 tools/test_scan_subject_binding_ungradable.py\n \n       # pq_key_binding.v1 keeps a reason vocabulary in which no_in_force_binding is reachable ONLY\n       # via revocation. That is the whole reason a separate authority_revoked field would be"},{"sha":"03504cfd382abe370c74165fa87c063a1dfda35d","filename":"conformance/scan-subject-binding-v0/scan_check.py","status":"modified","additions":25,"deletions":4,"changes":29,"blob_url":"https://github.com/trustless-ai/recompute-kit/blob/f7308cdd5ba55ac8229103e82ebc5fc14f81b88b/conformance%2Fscan-subject-binding-v0%2Fscan_check.py","raw_url":"https://github.com/trustless-ai/recompute-kit/raw/f7308cdd5ba55ac8229103e82ebc5fc14f81b88b/conformance%2Fscan-subject-binding-v0%2Fscan_check.py","contents_url":"https://api.github.com/repos/trustless-ai/recompute-kit/contents/conformance%2Fscan-subject-binding-v0%2Fscan_check.py?ref=f7308cdd5ba55ac8229103e82ebc5fc14f81b88b","patch":"@@ -165,19 +165,40 @@ def evaluate(name, c, pub, toy):\n           all(got[k] == e[k] for k in (\"result_only_check\", \"subject_bound_check\", \"evidence_grade\") if k in e))\n     return got, ok\n \n+# Fields a case's expectation must declare before it can be graded at all (Pavlo, #82): a nonempty expect that names none\n+# of them (or, for c0, not all three) has no expected-result relation to check, so it is ungradable, not reproduced.\n+C0_EXPECT = (\"signatures\", \"answer_A\", \"answer_B\")\n+GRADED_EXPECT = (\"result_only_check\", \"subject_bound_check\", \"evidence_grade\", \"replay_failures\")\n+def gradable(name, c):\n+    e = c.get(\"expect\") if isinstance(c, dict) else None\n+    if not isinstance(e, dict) or not e:\n+        return False\n+    if name.startswith(\"c0\"):\n+        return all(k in e for k in C0_EXPECT)\n+    return any(k in e for k in GRADED_EXPECT)\n+\n def main():\n     V, pub, toy = load(sys.argv[1] if len(sys.argv) > 1 else HERE / \"vectors.json\")\n     if isinstance(V[\"cases\"], dict) and not V[\"cases\"]:\n         print(\"UNVERIFIABLE: ZERO_CASES\", file=sys.stderr)\n         raise SystemExit(2)\n-    results = []\n+    results, ungradable = [], []\n     for name, c in sorted(V[\"cases\"].items()):\n+        # A case with no usable expectation was never graded, so it is neither refuted nor reproduced (recompute-kit#79, #82):\n+        # name it and exit 2 (could-not-grade). A graded mismatch elsewhere in the corpus still outranks it (exit 1).\n+        if not gradable(name, c):\n+            ungradable.append(name)\n+            continue\n         got, ok = evaluate(name, c, pub, toy)\n         results.append({\"case_id\": name, \"reproduced\": ok, \"result\": got})\n     reproduced = sum(r[\"reproduced\"] for r in results)\n-    print(json.dumps({\"profile\": PROFILE, \"results\": results, \"total\": len(results), \"reproduced\": reproduced},\n-                     sort_keys=True, indent=2))\n-    return 0 if reproduced == len(results) else 1\n+    print(json.dumps({\"profile\": PROFILE, \"results\": results, \"total\": len(results), \"reproduced\": reproduced,\n+                      \"ungradable\": ungradable, \"admitted\": len(V[\"cases\"])}, sort_keys=True, indent=2))\n+    for name in ungradable:\n+        print(f\"UNVERIFIABLE: {name}: no usable expectation to grade against\", file=sys.stderr)\n+    if reproduced < len(results):\n+        return 1\n+    return 2 if ungradable else 0\n \n if __name__ == \"__main__\":\n     sys.exit(main())"},{"sha":"e0db6cefed459e17a3d377302b0766cdaa6ad9bb","filename":"conformance/scan-subject-binding-v0/suite.json","status":"modified","additions":1,"deletions":1,"changes":2,"blob_url":"https://github.com/trustless-ai/recompute-kit/blob/f7308cdd5ba55ac8229103e82ebc5fc14f81b88b/conformance%2Fscan-subject-binding-v0%2Fsuite.json","raw_url":"https://github.com/trustless-ai/recompute-kit/raw/f7308cdd5ba55ac8229103e82ebc5fc14f81b88b/conformance%2Fscan-subject-binding-v0%2Fsuite.json","contents_url":"https://api.github.com/repos/trustless-ai/recompute-kit/contents/conformance%2Fscan-subject-binding-v0%2Fsuite.json?ref=f7308cdd5ba55ac8229103e82ebc5fc14f81b88b","patch":"@@ -6,7 +6,7 @@\n   },\n   \"checker\": {\n     \"path\": \"scan_check.py\",\n-    \"sha256\": \"2f46e494477a42fe4d0af80f1e7b8e8a2aae548c3808e6c20dc5e58675b7b18c\"\n+    \"sha256\": \"0cfe367fb7dd0d9aa8d0e8a560cf57971165c6822624b3c91cde9cfdaae0c733\"\n   },\n   \"mutation_checker\": {\n     \"path\": \"mutation_check.py\","},{"sha":"ea590ab3daa6abaed6e1807403ab5e5d6efe7412","filename":"tools/test_scan_subject_binding_ungradable.py","status":"added","additions":122,"deletions":0,"changes":122,"blob_url":"https://github.com/trustless-ai/recompute-kit/blob/f7308cdd5ba55ac8229103e82ebc5fc14f81b88b/tools%2Ftest_scan_subject_binding_ungradable.py","raw_url":"https://github.com/trustless-ai/recompute-kit/raw/f7308cdd5ba55ac8229103e82ebc5fc14f81b88b/tools%2Ftest_scan_subject_binding_ungradable.py","contents_url":"https://api.github.com/repos/trustless-ai/recompute-kit/contents/tools%2Ftest_scan_subject_binding_ungradable.py?ref=f7308cdd5ba55ac8229103e82ebc5fc14f81b88b","patch":"@@ -0,0 +1,122 @@\n+\"\"\"scan-subject-binding-v0: a case that was never graded is not a refuted case (#79).\n+\n+Controls (Pavlo's boundary on #79):\n+1. missing expectation -> exit 2 (UNVERIFIABLE), never SUITE;\n+2. a genuine mismatch -> exit 1 (SUITE);\n+3. mixed: a mismatch plus an ungradable case -> exit 1, both named in the output;\n+4. removing the guard restores the old wrong classification (SUITE from a KeyError);\n+5. a c0 case whose nonempty expect lacks its answer fields -> exit 2, not a KeyError (Pavlo, #82);\n+6. a non-c0 case whose nonempty expect names no graded field -> exit 2, not counted as reproduced (Pavlo, #82).\n+Runs on a disposable copy of the suite; the real corpus is untouched.\n+\"\"\"\n+from __future__ import annotations\n+\n+import copy\n+import json\n+from pathlib import Path\n+import shutil\n+import subprocess\n+import sys\n+import tempfile\n+import unittest\n+\n+sys.path.insert(0, str(Path(__file__).resolve().parent))\n+import run_conformance as runner\n+\n+SUITE = Path(__file__).resolve().parent.parent / \"conformance\" / \"scan-subject-binding-v0\"\n+GUARD = \"if not gradable(name, c):\"\n+\n+\n+class UngradableCase(unittest.TestCase):\n+    def setUp(self):\n+        self.tmp = Path(tempfile.mkdtemp())\n+        shutil.copytree(SUITE, self.tmp / \"s\")\n+        self.dir = self.tmp / \"s\"\n+        self.vectors = json.loads((SUITE / \"vectors.json\").read_text())\n+\n+    def tearDown(self):\n+        shutil.rmtree(self.tmp)\n+\n+    def _probe(self, *, drop_expect=True, break_one=False):\n+        v = copy.deepcopy(self.vectors)\n+        name = next(n for n in sorted(v[\"cases\"]) if not n.startswith(\"c0\"))\n+        if drop_expect:\n+            probe = copy.deepcopy(v[\"cases\"][name])\n+            del probe[\"expect\"]\n+            v[\"cases\"][name + \"__probe_no_expect\"] = probe\n+        if break_one:\n+            e = v[\"cases\"][name][\"expect\"]\n+            e[\"subject_bound_check\"] = \"NOT_A_VERDICT\"\n+        (self.dir / \"vectors.json\").write_text(json.dumps(v))\n+\n+    def _run(self):\n+        p = subprocess.run([sys.executable, \"scan_check.py\", \"vectors.json\"], cwd=self.dir,\n+                           capture_output=True, text=True, timeout=120)\n+        out = p.stdout + p.stderr\n+        kind = None if p.returncode == 0 else runner.classify_process_failure(p.returncode, out, \"scan_check.py\").kind\n+        return p.returncode, kind, p.stdout, p.stderr\n+\n+    def test_1_missing_expectation_is_unverifiable(self):\n+        self._probe()\n+        rc, kind, out, err = self._run()\n+        self.assertEqual((rc, kind), (2, \"UNVERIFIABLE\"))\n+        doc = json.loads(out)\n+        self.assertEqual(len(doc[\"ungradable\"]), 1)\n+        self.assertEqual(doc[\"total\"] + len(doc[\"ungradable\"]), doc[\"admitted\"])\n+        self.assertEqual(doc[\"reproduced\"], doc[\"total\"])\n+\n+    def test_2_genuine_mismatch_is_refutation(self):\n+        self._probe(drop_expect=False, break_one=True)\n+        rc, kind, _, _ = self._run()\n+        self.assertEqual((rc, kind), (1, \"SUITE\"))\n+\n+    def test_3_mixed_keeps_both_refutation_wins(self):\n+        self._probe(break_one=True)\n+        rc, kind, out, err = self._run()\n+        self.assertEqual((rc, kind), (1, \"SUITE\"))\n+        doc = json.loads(out)\n+        self.assertEqual(len(doc[\"ungradable\"]), 1)\n+        self.assertLess(doc[\"reproduced\"], doc[\"total\"])\n+        self.assertIn(\"no usable expectation to grade against\", err)\n+\n+    def test_4_guard_is_load_bearing(self):\n+        src = (self.dir / \"scan_check.py\").read_text()\n+        self.assertEqual(src.count(GUARD), 1)\n+        (self.dir / \"scan_check.py\").write_text(src.replace(GUARD, \"if False:\"))\n+        self._probe()\n+        rc, kind, _, err = self._run()\n+        self.assertEqual((rc, kind), (1, \"SUITE\"))\n+        self.assertIn(\"KeyError\", err)\n+\n+    def _probe_expect(self, *, c0, expect):\n+        v = copy.deepcopy(self.vectors)\n+        name = next(n for n in sorted(v[\"cases\"]) if n.startswith(\"c0\") == c0)\n+        probe = copy.deepcopy(v[\"cases\"][name])\n+        probe[\"expect\"] = expect\n+        v[\"cases\"][name + \"__probe\"] = probe\n+        (self.dir / \"vectors.json\").write_text(json.dumps(v))\n+        return name + \"__probe\"\n+\n+    def _assert_ungradable(self, probe):\n+        rc, kind, out, err = self._run()\n+        self.assertEqual((rc, kind), (2, \"UNVERIFIABLE\"), err)\n+        doc = json.loads(out)\n+        self.assertEqual(doc[\"ungradable\"], [probe])\n+        self.assertEqual(doc[\"reproduced\"], doc[\"total\"])\n+        self.assertEqual(doc[\"total\"] + 1, doc[\"admitted\"])\n+        self.assertNotIn(\"KeyError\", err)\n+\n+    def test_5_c0_expect_without_answers_is_unverifiable(self):\n+        self._assert_ungradable(self._probe_expect(c0=True, expect={\"signatures\": \"valid\"}))\n+\n+    def test_6_metadata_only_expect_is_not_reproduced(self):\n+        self._assert_ungradable(self._probe_expect(c0=False, expect={\"reason\": \"metadata only\"}))\n+\n+    def test_real_corpus_still_passes(self):\n+        rc, _, out, _ = self._run()\n+        self.assertEqual(rc, 0)\n+        self.assertEqual(json.loads(out)[\"ungradable\"], [])\n+\n+\n+if __name__ == \"__main__\":\n+    unittest.main()"}]}