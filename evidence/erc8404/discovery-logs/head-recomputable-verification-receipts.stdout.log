+      ],\n+      \"properties\": {\n+        \"procedure\": {\n+          \"const\": \"JUDGE_PROTOCOL_CHECKER_DERIVATION_V0\"\n+        },\n+        \"checkerContract\": {\n+          \"const\": \"judge-protocol-checkers-v1\"\n+        },\n+        \"judgeByteContract\": {\n+          \"const\": \"judge-protocol-sorted-json-v1\"\n+        },\n+        \"chainSemantics\": {\n+          \"const\": \"SNAPSHOT_BOUND_CANONICALITY_NOT_ESTABLISHED\"\n+        },\n+        \"timestampSemantics\": {\n+          \"const\": \"RECORDED_NOT_REDERIVED\"\n+        },\n+        \"jobId\": {\n+          \"$ref\": \"#/$defs/decimal\"\n+        },\n+        \"snapshotBlock\": {\n+          \"oneOf\": [\n+            {\n+              \"type\": \"null\"\n+            },\n+            {\n+              \"type\": \"object\",\n+              \"additionalProperties\": false,\n+              \"required\": [\n+                \"number\",\n+                \"hash\"\n+              ],\n+              \"properties\": {\n+                \"number\": {\n+                  \"$ref\": \"#/$defs/decimal\"\n+                },\n+                \"hash\": {\n+                  \"$ref\": \"#/$defs/bytes32\"\n+                }\n+              }\n+            }\n+          ]\n+        },\n+        \"criteriaHash\": {\n+          \"$ref\": \"#/$defs/nullableBytes32\"\n+        },\n+        \"deliverableCommitment\": {\n+          \"$ref\": \"#/$defs/nullableBytes32\"\n+        },\n+        \"checks\": {\n+          \"type\": \"array\",\n+          \"maxItems\": 64,\n+          \"items\": {\n+            \"$ref\": \"#/$defs/check\"\n+          }\n+        },\n+        \"score\": {\n+          \"$ref\": \"#/$defs/nullableDecimal\"\n+        },\n+        \"threshold\": {\n+          \"$ref\": \"#/$defs/nullableDecimal\"\n+        },\n+        \"pass\": {\n+          \"oneOf\": [\n+            {\n+              \"type\": \"boolean\"\n+            },\n+            {\n+              \"type\": \"null\"\n+            }\n+          ]\n+        },\n+        \"evidenceHash\": {\n+          \"$ref\": \"#/$defs/nullableBytes32\"\n+        },\n+        \"onChainVerdict\": {\n+          \"oneOf\": [\n+            {\n+              \"enum\": [\n+                \"PASS\",\n+                \"REJECT\",\n+                \"NONE\"\n+              ]\n+            },\n+            {\n+              \"type\": \"null\"\n+            }\n+          ]\n+        },\n+        \"verdictAgreement\": {\n+          \"enum\": [\n+            \"MATCHES\",\n+            \"DIFFERS\",\n+            \"NO_VERDICT\",\n+            \"NOT_EVALUATED\"\n+          ]\n+        }\n+      }\n+    },\n+    \"canonicalResult\": {\n+      \"type\": \"object\",\n+      \"additionalProperties\": false,\n+      \"required\": [\n+        \"schema\",\n+        \"proposition\",\n+        \"outcome\",\n+        \"reasonCode\",\n+        \"evaluation\"\n+      ],\n+      \"properties\": {\n+        \"schema\": {\n+          \"const\": \"rvr.canonical-result.judge-protocol.v0\"\n+        },\n+        \"proposition\": {\n+          \"const\": \"rvr.judge-protocol.v0.deliverable_meets_criteria\"\n+        },\n+        \"outcome\": {\n+          \"$ref\": \"#/$defs/outcome\"\n+        },\n+        \"reasonCode\": {\n+          \"$ref\": \"#/$defs/verificationReasonCode\"\n+        },\n+        \"evaluation\": {\n+          \"$ref\": \"#/$defs/evaluation\"\n+        }\n+      }\n+    }\n+  }\n+}"},{"sha":"92575e18e9770a1e860fea9afc6d8d3fba2d5161","filename":"profiles/judge-protocol-rvr-v0/test_profile.py","status":"added","additions":48,"deletions":0,"changes":48,"blob_url":"https://github.com/pipavlo82/recomputable-verification-receipts/blob/9dd36e882dd372f264b77b179130948aa5adcbde/profiles%2Fjudge-protocol-rvr-v0%2Ftest_profile.py","raw_url":"https://github.com/pipavlo82/recomputable-verification-receipts/raw/9dd36e882dd372f264b77b179130948aa5adcbde/profiles%2Fjudge-protocol-rvr-v0%2Ftest_profile.py","contents_url":"https://api.github.com/repos/pipavlo82/recomputable-verification-receipts/contents/profiles%2Fjudge-protocol-rvr-v0%2Ftest_profile.py?ref=9dd36e882dd372f264b77b179130948aa5adcbde","patch":"@@ -0,0 +1,48 @@\n+\"\"\"Focused test for judge-protocol-rvr-v0.\n+\n+Modeled, with changes, on the profile tests in pipavlo82/recomputable-verification-receipts\n+(commit 287c0ea, Apache License 2.0).\n+\"\"\"\n+import json\n+import subprocess\n+import sys\n+import unittest\n+from pathlib import Path\n+\n+\n+ROOT = Path(__file__).resolve().parents[2]\n+ADAPTER = Path(__file__).with_name(\"adapter.py\")\n+\n+\n+class JudgeProtocolProfileTests(unittest.TestCase):\n+    def test_exact_gate(self) -> None:\n+        completed = subprocess.run(\n+            [sys.executable, str(ADAPTER), \"--check\"],\n+            cwd=ROOT,\n+            check=True,\n+            capture_output=True,\n+            text=True,\n+        )\n+        report = json.loads(completed.stdout)\n+        cases = report[\"cases\"]\n+        self.assertEqual(report[\"gate\"], \"RVR_JUDGE_PROTOCOL_V0_PASS\")\n+        self.assertEqual(cases[\"REPRODUCED\"][\"recomputationStatus\"], \"REPRODUCED\")\n+        self.assertEqual(cases[\"REPRODUCED\"][\"verdictAgreement\"], \"MATCHES\")\n+        self.assertEqual(cases[\"REFUTED_REPRODUCED\"][\"verdictAgreement\"], \"MATCHES\")\n+        self.assertEqual(cases[\"DIVERGED\"][\"recomputationStatus\"], \"DIVERGED\")\n+        self.assertEqual(cases[\"UNVERIFIABLE_REPRODUCED\"][\"recomputationStatus\"], \"REPRODUCED\")\n+        self.assertEqual(cases[\"CANNOT_RECOMPUTE_PRECEDES_GATES\"][\"recomputationStatus\"], \"CANNOT_RECOMPUTE\")\n+        self.assertEqual(cases[\"TAMPERED_PROFILE_CONSTRAINTS_PIN\"][\"recomputationStatus\"], \"CANNOT_RECOMPUTE\")\n+        self.assertFalse(cases[\"TAMPERED_PROFILE_CONSTRAINTS_PIN\"][\"constraintsApplied\"])\n+        self.assertFalse(cases[\"HIDDEN_STATE_NEGATIVE_CONTROL\"][\"evaluationPerformed\"])\n+        self.assertEqual(cases[\"ONCHAIN_VERDICT_BOUNDARY\"][\"verdictAgreement\"], \"DIFFERS\")\n+        self.assertEqual(cases[\"VERDICT_FIELD_CONTROLS\"][\"pass\"], \"DIFFERS\")\n+        self.assertEqual(cases[\"VERDICT_FIELD_CONTROLS\"][\"timestamp\"], \"MATCHES\")\n+        self.assertEqual(len(cases), 31)\n+        self.assertEqual(report[\"semanticCases\"][\"passed\"], 31)\n+        self.assertEqual(report[\"gateCases\"][\"passed\"], 74)\n+        self.assertEqual(report[\"byteContractVectors\"][\"passed\"], 5)\n+        self.assertEqual(report[\"wordCharacterRanges\"], 778)\n+\n+if __name__ == \"__main__\":\n+    unittest.main()"},{"sha":"17135d24894e70e960d2b6d8f9b779c41acb3b4c","filename":"profiles/judge-protocol-rvr-v0/upstream/job-186779.deliverable.bin","status":"added","additions":1,"deletions":0,"changes":1,"blob_url":"https://github.com/pipavlo82/recomputable-verification-receipts/blob/9dd36e882dd372f264b77b179130948aa5adcbde/profiles%2Fjudge-protocol-rvr-v0%2Fupstream%2Fjob-186779.deliverable.bin","raw_url":"https://github.com/pipavlo82/recomputable-verification-receipts/raw/9dd36e882dd372f264b77b179130948aa5adcbde/profiles%2Fjudge-protocol-rvr-v0%2Fupstream%2Fjob-186779.deliverable.bin","contents_url":"https://api.github.com/repos/pipavlo82/recomputable-verification-receipts/contents/profiles%2Fjudge-protocol-rvr-v0%2Fupstream%2Fjob-186779.deliverable.bin?ref=9dd36e882dd372f264b77b179130948aa5adcbde","patch":"@@ -0,0 +1 @@\n+ERC-8183 holds the client's USDC in escrow on Arc until the evaluator rules on the submitted work.\n\\ No newline at end of file"},{"sha":"32412777d0e721944428b876d09068352f4baef8","filename":"profiles/judge-protocol-rvr-v0/upstream/job-186779.snapshot.json","status":"added","additions":1,"deletions":0,"changes":1,"blob_url":"https://github.com/pipavlo82/recomputable-verification-receipts/blob/9dd36e882dd372f264b77b179130948aa5adcbde/profiles%2Fjudge-protocol-rvr-v0%2Fupstream%2Fjob-186779.snapshot.json","raw_url":"https://github.com/pipavlo82/recomputable-verificatio