   \"bytes\": 50615\n+    },\n+    {\n+      \"path\": \"results/S-signature.json\",\n+      \"sha256\": \"0391236e03935fd77df43584df2454cf8789e93c10d3665f0362bd4207925fa7\",\n+      \"bytes\": 50762\n+    },\n+    {\n+      \"path\": \"results/summary.json\",\n+      \"sha256\": \"10b76294c94a4f9503d20b715124305ca1d8561c411583e362638347df8b832f\",\n+      \"bytes\": 16972\n+    }\n+  ]\n+}"},{"sha":"045872e9af94e4ae92e2625d424990f947df5d17","filename":"reports/release-audit-v0.2/core/probe.mjs","status":"added","additions":85,"deletions":0,"changes":85,"blob_url":"https://github.com/pipavlo82/receiptos-verify/blob/396143120f787d2f5534e92c0cf896c029a05775/reports%2Frelease-audit-v0.2%2Fcore%2Fprobe.mjs","raw_url":"https://github.com/pipavlo82/receiptos-verify/raw/396143120f787d2f5534e92c0cf896c029a05775/reports%2Frelease-audit-v0.2%2Fcore%2Fprobe.mjs","contents_url":"https://api.github.com/repos/pipavlo82/receiptos-verify/contents/reports%2Frelease-audit-v0.2%2Fcore%2Fprobe.mjs?ref=396143120f787d2f5534e92c0cf896c029a05775","patch":"@@ -0,0 +1,85 @@\n+import {readFile,writeFile,mkdir} from 'node:fs/promises';\n+import {resolve} from 'node:path';\n+import {pathToFileURL} from 'node:url';\n+import {execFileSync} from 'node:child_process';\n+import {fresh,resign,attach,sha,bytes} from './independent-input.mjs';\n+const repo=resolve(process.argv[2]),out=resolve(process.argv[3]);\n+await mkdir(out,{recursive:true});\n+const {verify}=await import(pathToFileURL(resolve(repo,'src/core/verify.mjs')));\n+const base=await fresh(repo),clone=v=>structuredClone(v),cases=[];\n+function add(id,relation,expected,reason,change=()=>{},pair=clone(base),options={}){change(pair);cases.push({id,relation,expected,reason,pair,...options});}\n+add('D1','Fresh independently signed commit A and exact requested surface','VERIFIED',null);\n+add('D2','Same authenticated receipt A cannot cover requested commit B','CONTRADICTED','SUBJECT_MISMATCH',p=>p.request.subject.commit='b'.repeat(40));\n+add('A01','Same claim, different requested subject','CONTRADICTED','SUBJECT_MISMATCH',p=>p.request.subject.id='audit02:other-subject');\n+add('A02','Same subject, different artifact digest','CONTRADICTED','ARTIFACT_MISMATCH',p=>p.request.subject.artifact_digest='a'.repeat(64));\n+add('A03','Same subject/artifact, different authority','CONTRADICTED','AUTHORITY_MISMATCH',p=>p.request.authority.id='different-authority');\n+add('A04','Same subject, requested scope expansion','CONTRADICTED','SCOPE_MISMATCH',p=>p.request.scope.complete_execution=true);\n+add('A05','Wrong caller policy ID','CONTRADICTED','POLICY_MISMATCH',p=>p.request.policy.id='other-policy');\n+add('A05b','Wrong caller policy version','CONTRADICTED','POLICY_MISMATCH',p=>p.request.policy.version='different-version');\n+add('A06','Wrong claim version','CONTRADICTED','VERSION_MISMATCH',p=>p.request.version='audit.3');\n+add('A06b','Wrong subject version','CONTRADICTED','VERSION_MISMATCH',p=>p.request.subject.version='subject.v99');\n+add('A07','Time after interval end','CONTRADICTED','TIME_MISMATCH',p=>p.request.policy.verification_time=p.request.time.not_after);\n+add('A07b','Time before interval start','CONTRADICTED','TIME_MISMATCH',p=>p.request.policy.verification_time=p.request.time.not_before-1);\n+add('A08','Required assumption absent from accepted premises','INSUFFICIENT_EVIDENCE','ASSUMPTION_UNESTABLISHED',p=>p.request.assumptions=['operator-independent']);\n+add('A08p','Required assumption accepted by caller premise','VERIFIED',null,p=>{p.request.assumptions=['operator-independent'];p.request.policy.established_assumptions=['operator-independent'];});\n+add('A09','Required dependency undeclared and unsatisfied','INSUFFICIENT_EVIDENCE','DEPENDENCY_MISSING',p=>p.request.dependencies=[{id:'dep:clock',version:'1'}]);\n+add('A10','Required dependency explicitly contradicted','CONTRADICTED','DEPENDENCY_CONTRADICTED',p=>{p.request.dependencies=[{id:'dep:clock',version:'1'}];p.request.policy.dependency_results=[{id:'dep:clock',version:'1',status:'CONTRADICTED'}];});\n+add('A10p','Declared dependency with accepted exact result','VERIFIED',null,p=>{p.request.dependencies=[{id:'dep:clock',version:'1'}];p.request.policy.dependency_results=[{id:'dep:clock',version:'1',status:'SATISFIED'}];p.bundle.statement.surface.dependencies=[{id:'dep:clock',version:'1'}];resign(p);});\n+add('A11','Simultaneous claim subject artifact authority scope policy version time contradiction','CONTRADICTED','CLAIM_MISMATCH',p=>{p.request.claim.id='other';p.request.subject.id='other';p.request.subject.artifact_digest='b'.repeat(64);p.request.authority.id='other';p.request.scope.extra=true;p.request.policy.version='other';p.request.version='other';p.request.policy.verification_time=0;});\n+add('A12','Absent required subject','REJECTED_MALFORMED','SCHEMA_MISMATCH',p=>delete p.request.subject);\n+add('A12b','Null required subject','REJECTED_MALFORMED','SCHEMA_MISMATCH',p=>p.request.subject=null);\n+add('A12c','Absent optional artifact digest vs declared digest','CONTRADICTED','ARTIFACT_MISMATCH',p=>delete p.request.subject.artifact_digest);\n+add('A12d','Null optional artifact digest','REJECTED_MALFORMED','SCHEMA_MISMATCH',p=>p.request.subject.artifact_digest=null);\n+add('A13','Duplicate conflicting dependency result declarations','REJECTED_MALFORMED','DEPENDENCY_RESULT_ID_DUPLICATE',p=>p.request.policy.dependency_results=[{id:'same',version:'1',status:'SATISFIED'},{id:'same',version:'1',status:'CONTRADICTED'}]);\n+add('A13b','Duplicate dependency IDs with distinct versions','REJECTED_MALFORMED','DEPENDENCY_ID_DUPLICATE',p=>p.request.dependencies=[{id:'same',version:'1'},{id:'same',version:'2'}]);\n+add('A14','Whitespace/member order/CRLF preserve exact JSON semantics','VERIFIED',null,()=>{},clone(base),{wire:'formatted'});\n+add('A14b','NFC and NFD identifier spellings remain distinct','CONTRADICTED','SUBJECT_MISMATCH',p=>{p.bundle.statement.surface.subject.id='caf\\u00e9';p.request.subject.id='cafe\\u0301';resign(p);});\n+add('A15','Same artifact digest, unsupported broader semantic declaration','CONTRADICTED','SCOPE_MISMATCH',p=>p.request.scope.provider_authenticity=true);\n+add('D12','Empty manifest and empty attachment evidence cannot verify','INSUFFICIENT_EVIDENCE','EVIDENCE_MISSING',p=>{p.bundle.statement.evidence_manifest=[];p.bundle.evidence=[];resign(p);});\n+add('D14','Unknown profile cannot verify','UNSUPPORTED_PROFILE','UNSUPPORTED_PROFILE',p=>p.request.verification_profile='receiptos.verify.generic.v999');\n+add('M-empty-request','Empty request object','REJECTED_MALFORMED','SCHEMA_MISMATCH',p=>p.request={});\n+add('M-null','Null request','REJECTED_MALFORMED',null,p=>p.request=null);\n+add('M-array','Array root','REJECTED_MALFORMED',null,p=>p.request=[]);\n+add('M-root-string','String root','REJECTED_MALFORMED',null,p=>p.request='\"root\"');\n+add('M-empty-document','Empty document','REJECTED_MALFORMED','MALFORMED_JSON',p=>p.request='');\n+add('M-duplicate-json','Duplicate semantic JSON key','REJECTED_MALFORMED','DUPLICATE_JSON_KEY',p=>p.request=JSON.stringify(p.request).replace('\"schema\":','\"schema\":\"duplicate\",\"schema\":'));\n+add('M-extra','Extra root member','REJECTED_MALFORMED','SCHEMA_MISMATCH',p=>p.request.unrecognized='value');\n+add('M-hash','Malformed artifact hash','REJECTED_MALFORMED','SCHEMA_MISMATCH',p=>p.request.subject.artifact_digest='not-a-hash');\n+add('M-hash-case','Uppercase artifact hash rejected as noncanonical','REJECTED_MALFORMED','SCHEMA_MISMATCH',p=>p.request.subject.artifact_digest=p.request.subject.artifact_digest.toUpperCase());\n+add('M-long','Bounded string above identity maximum','REJECTED_MALFORMED','SCHEMA_MISMATCH',p=>p.request.subject.id='x'.repeat(1025));\n+add('M-large-document','Document above 4 MiB','REJECTED_MALFORMED','INPUT_TOO_LARGE',p=>p.request='{\"padding\":\"'+'x'.repeat(4*1024*1024)+'\"}');\n+add('M-unpaired-surrogate','Unpaired Unicode surrogate','REJECTED_MALFORMED','INVALID_UNICODE',p=>p.request.subject.id='\\ud800');\n+add('M-invalid-utf8','Invalid UTF-8 byte input','REJECTED_MALFORMED','INVALID_UTF8',p=>p.request=Buffer.from([0x7b,0x22,0xff,0x22,0x3a,0x31,0x7d]));\n+add('M-traversal','Path traversal in subject declaration','REJECTED_MALFORMED','ARTIFACT_PATH_MALFORMED',p=>p.request.subject.artifact_path='../audited.txt');\n+add('M-uri','Unsupported URI in path field','REJECTED_MALFORMED','SCHEMA_MISMATCH',p=>p.request.subject.artifact_path='https://attacker.invalid/audited.txt');\n+add('M-overflow','Numeric overflow beyond exact safe integers','REJECTED_MALFORMED','UNSAFE_JSON_NUMBER',p=>p.request=JSON.stringify(p.request).replace('1791676800','9007199254740992'));\n+add('M-underflow','Fractional numeric underflow unsupported','REJECTED_MALFORMED','UNSAFE_JSON_NUMBER',p=>p.request=JSON.stringify(p.request).replace('1791676800','1e-9999'));\n+add('M-nan','NaN JSON extension rejected','REJECTED_MALFORMED','MALFORMED_JSON',p=>p.request=JSON.stringify(p.request).replace('1791676800','NaN'));\n+add('M-infinity','Infinity JSON extension rejected','REJECTED_MALFORMED','MALFORMED_JSON',p=>p.request=JSON.stringify(p.request).replace('1791676800','Infinity'));\n+add('M-evidence-duplicate','Duplicate evidence ID','REJECTED_MALFORMED','DUPLICATE_EVIDENCE',p=>p.bundle.evidence.push(clone(p.bundle.evidence[0])));\n+add('M-evidence-conflict','Different bytes under signed evidence ID','REJECTED_MALFORMED','ATTACHMENT_INTEGRITY_MISMATCH',p=>p.bundle.evidence[0].bytes_base64=Buffer.from('different').toString('base64'));\n+add('M-adapter','Unknown adapter','UNSUPPORTED_PROFILE','UNSUPPORTED_PROFILE',p=>p.request.adapter='unknown-adapter');\n+add('M-semantic-profile','Unknown semantic profile version','UNSUPPORTED_PROFILE','UNSUPPORTED_PROFILE',p=>p.request.semantic_profile='receiptos.verify.semantic-abi.v999');\n+add('M-canon-profile','Unsupported canonicalization profile','REJECTED_MALFORMED','CANONICALIZATION_PROFILE_UNSUPPORTED',p=>p.bundle.canonicalization_profile='unknown-canonical-json');\n+add('S-signature','False signature cannot verify','CONTRADICTED','INVALID_SIGNATURE',p=>p.bundle.signature_base64=Buffer.alloc(64).toString('base64'));\n+add('S-root','Tampered Crystal root cannot verify','REJECTED_MALFORMED','RECEIPT_ROOT_MISMATCH',p=>{p.bundle.payload.crystal.anchor.receipt_root='0x'+'0'.repeat(64);resign(p);});\n+add('S-negative','Fresh correctly reproduced negative remains contradiction','CONTRADICTED','NATIVE_NEGATIVE_RESULT',()=>{},await fresh(repo,{negative:true}));\n+add('S-native-pass-claim','Native positive with a different requested claim cannot bypass compatibility','CONTRADICTED','CLAIM_MISMATCH',p=>p.request.claim.id='unestablished-claim');\n+const results=[];\n+const pack=v=>Buffer.isBuffer(v)?{encoding:'base64',bytes:v.toString('base64')}:typeof v==='string'?{encoding:'utf8',text:v}:{encoding:'json',value:v};\n+for(const c of cases){\n+  let req=c.pair.request,bun=c.pair.bundle;\n+  if(c.wire==='formatted'){\n+    const reverse=v=>Array.isArray(v)?v.map(reverse):v&&typeof v==='object'?Object.fromEntries(Object.entries(v).reverse().map(([k,x])=>[k,reverse(x)])):v;\n+    req=JSON.stringify(reverse(req),null,2).replaceAll('\\n','\\r\\n');bun=JSON.stringify(reverse(bun),null,2).replaceAll('\\n','\\r\\n');\n+  }\n+  const input={request:pack(req),bundle:pack(bun)};\n+  const actual=await verify(req,bun);\n+  const passed=actual.overall===c.expected&&(!c.reason||actual.reason_codes.includes(c.reason));\n+  const receipt={id:c.id,relation:c.relation,oracle:{type:'INDEPENDENT_LITERAL',overall:c.expected,reason:c.reason},input,actual,passed,inputSha256:sha(Buffer.from(JSON.stringify(input)))};\n+  await writeFile(resolve(out,c.id+'.json'),JSON.stringify(receipt,null,2)+'\\n');\n+  results.push({id:c.id,expected:c.expected,actual:actual.overall,reason:c.reason,actualReasons:actual.reason_codes,passed});\n+}\n+const summary={candidate:execFileSync('git',['rev-parse','HEAD'],{cwd:repo,encoding:'utf8'}).trim(),repo,generatedAt:new Date().toISOString(),fixtureMethod:'Independent Node crypto, own canonical encoder, raw Git objects, literal RVR canonical outcomes and direct Crystal root construction; no product fixture generator imports.',total:results.length,passed:results.filter(x=>x.passed).length,failed:results.filter(x=>!x.passed).length,results};\n+await writeFile(resolve(out,'summary.json'),JSON.stringify(summary,null,2)+'\\n');\n+console.log(JSON.stringify(summary,null,2));"},{"sha":"064060eed5785312690d5d5105e5beadffbe26e1","filename":"reports/release-audit-v0.2/core/projection-probe.mjs","status":"added","additions":63,"deletions":0,"changes":63,"blob_url":"https://github.com/pipavlo82/receiptos-verify/blob/396143120f787d2f5534e92c0cf896c029a05775/reports%2Frelease-audit-v0.2%2Fcore%2Fprojection-probe.mjs","raw_url":"https://github.com/pipavlo82/receiptos-verify/raw/396143120f787d2f5534e92c0cf896c029a05775/reports%2Frelease-audit-v0.2%2Fcore%2Fprojection-probe.mjs","contents_url":"https://api.github.com/repos/pipavlo82/receiptos-verify/contents/reports%2Frelease-audit-v0.2%2Fcore%2Fprojection-probe.mjs?ref=396143120f787d2f5534e92c0cf896c029a05775","patch":"@@ -0,0 +1,63 @@\n+import {writeFile,mkdir} from 'node:fs/promises';\n+import {resolve} from 'node:path';\n+import {pathToFileURL} from 'node:url';\n+const repo=resolve(process.argv[2]),out=resolve(process.argv[3]);await mkdir(out,{recursive:true});\n+const {projectV2}=await import(pathToFileURL(resolve(repo,'src/projection/project-v2.mjs')));\n+const critical=['INTEGRITY','AUTHENTICITY','SUBJECT_BINDING','RECOMPUTATION','EVIDENCE_SUFFICIENCY','SEMANTIC_COMPATIBILITY'];\n+const success={INTEGRITY:['VERIFIED'],AUTHENTICITY:['VERIFIED'],SUBJECT_BINDING:['VERIFIED'],RECOMPUTATION:['REPRODUCED'],EVIDENCE_SUFFICIENCY:['SUFFICIENT'],SEMANTIC_COMPATIBILITY:['COMPATIBLE'],GUARANTEE_PRESERVATION:['PRESERVED'],CONTINUITY:['PRESERVED','VERIFIED'],DOMAIN_ADAPTERS:['VERIFIED','PRESERVED']};\n+const vocabulary={INPUT:['ADMITTED','REJECTED_MALFORMED','NOT_RUN'],CANONICALIZATION:['VERIFIED','NOT_RUN'],INTEGRITY:['VERIFIED','REJECTED_MALFORMED','CANNOT_RECOMPUTE','INSUFFICIENT_EVIDENCE','NOT_RUN'],AUTHENTICITY:['VERIFIED','CONTRADICTED','NOT_ESTABLISHED','NOT_RUN'],SUBJECT_BINDING:['VERIFIED','CONTRADICTED','INSUFFICIENT_EVIDENCE','NOT_RUN'],RECOMPUTATION:['REPRODUCED','DIVERGED','CANNOT_RECOMPUTE','CONTRADICTED','REJECTED_MALFORMED','INSUFFICIENT_EVIDENCE','UNSUPPORTED','NOT_RUN'],EVIDENCE_SUFFICIENCY:['SUFFICIENT','INSUFFICIENT','NOT_RUN'],SEMANTIC_COMPATIBILITY:['COMPATIBLE','CONTRADICTED','INSUFFICIENT_EVIDENCE','UNSUPPORTED','NOT_RUN'],GUARANTEE_PRESERVATION:['PRESERVED','VIOLATED','UNVERIFIABLE','NOT_REQUESTED','NOT_RUN'],CONTINUITY:['PRESERVED','VERIFIED','VIOLATED','UNVERIFIABLE','NOT_REQUESTED','NOT_RUN'],DOMAIN_ADAPTERS:['VERIFIED','PRESERVED','CONTRADICTED','VIOLATED','UNVERIFIABLE','NOT_ESTABLISHED','INSUFFICIENT_EVIDENCE','CANNOT_RECOMPUTE','REJECTED_MALFORMED','UNSUPPORTED','UNSUPPORTED_PROFILE','NOT_REQUESTED','NOT_RUN'],PRODUCT_PROJECTION:['NOT_RUN'],EXPLAINABLE_REPORT:['NOT_RUN'],PROVENANCE:['RECORDED','NOT_RUN']};\n+const baseline=Object.fromEntries(Object.entries(vocabulary).map(([k,v])=>[k,{status:v[0],reasonCodes:[],nativeResult:null}]));\n+baseline.RECOMPUTATION.semanticOutcome='VERIFIED';\n+for(const k of ['GUARANTEE_PRESERVATION','CONTINUITY','DOMAIN_ADAPTERS'])baseline[k].status='NOT_REQUESTED';\n+const decisionTable=[\n+ {priority:1,condition:'Invalid inventory, data representation, native semantic vocabulary, required-layer list or support flag',verdict:'REJECTED_MALFORMED'},\n+ {priority:2,condition:'Any supplied layer/nested PRF product result is REJECTED_MALFORMED',verdict:'REJECTED_MALFORMED'},\n+ {priority:3,condition:'Any supplied layer/nested PRF contradicts/violates OR recomputation semantic result is REFUTED',verdict:'CONTRADICTED'},\n+ {priority:4,condition:'Unsupported profile OR a required layer/nested PRF is unsupported',verdict:'UNSUPPORTED_PROFILE'},\n+ {priority:5,condition:'Required recomputation unavailable/diverged OR required nested PRF is CANNOT_RECOMPUTE',verdict:'CANNOT_RECOMPUTE'},\n+ {priority:6,condition:'Mandatory or selected positive premise is unestablished',verdict:'INSUFFICIENT_EVIDENCE'},\n+ {priority:7,condition:'All guards clear; all required successes established; native semantic result positive',verdict:'VERIFIED'},\n+];\n+// Independently authored contract oracle. Inputs below are valid data-shaped\n+// layer reports; malformed representation probes have detached literal answers.\n+function oracle(layers,required,supported){\n+  const obligation=[...new Set([...critical,...required])],prf=layers.GUARANTEE_PRESERVATION.productProjection;\n+  const statuses=Object.values(layers).map(v=>v.status);if(prf)statuses.push(prf.status);\n+  if(statuses.includes('REJECTED_MALFORMED'))return 'REJECTED_MALFORMED';\n+  if(statuses.some(s=>s==='CONTRADICTED'||s==='VIOLATED')||layers.RECOMPUTATION.semanticOutcome==='REFUTED')return 'CONTRADICTED';\n+  if(supported===false||obligation.some(k=>['UNSUPPORTED','UNSUPPORTED_PROFILE'].includes(layers[k].status))||obligation.includes('GUARANTEE_PRESERVATION')&&prf?.status==='UNSUPPORTED_PROFILE')return 'UNSUPPORTED_PROFILE';\n+  if(obligation.some(k=>['CANNOT_RECOMPUTE','DIVERGED'].includes(layers[k].status))||obligation.includes('GUARANTEE_PRESERVATION')&&prf?.status==='CANNOT_RECOMPUTE')return 'CANNOT_RECOMPUTE';\n+  if(layers.INPUT.status!=='ADMITTED'||layers.CANONICALIZATION.status!=='VERIFIED'||layers.RECOMPUTATION.semanticOutcome!=='VERIFIED'||obligation.some(k=>!success[k].includes(layers[k].status))||obligation.includes('GUARANTEE_PRESERVATION')&&prf&&prf.status!=='VERIFIED')return 'INSUFFICIENT_EVIDENCE';\n+  return 'VERIFIED';\n+}\n+const rows=[],clone=v=>structuredClone(v);\n+function run(id,layers,required=[],supported=true,expected){\n+ const literal=expected??oracle(layers,required,supported),actual=projectV2(layers,required,supported);\n+ rows.push({id,layers,required,supported,expected:literal,actual:actual.status,reasonCodes:actual.reasonCodes,passed:literal===actual.status});\n+}\n+run('baseline',clone(baseline));\n+const axes=Object.entries(vocabulary).filter(([name])=>!['PRODUCT_PROJECTION','EXPLAINABLE_REPORT','PROVENANCE'].includes(name));\n+for(let i=0;i<axes.length;i++)for(let j=i;j<axes.length;j++){\n+ const [a,as]=axes[i],[b,bs]=axes[j];\n+ for(const x of as)for(const y of bs){\n+  const layers=clone(baseline);layers[a].status=x;layers[b].status=y;\n+  run(`${a}:${x}|${b}:${y}`,layers);\n+  if(['GUARANTEE_PRESERVATION','CONTINUITY','DOMAIN_ADAPTERS'].includes(a)||['GUARANTEE_PRESERVATION','CONTINUITY','DOMAIN_ADAPTERS'].includes(b))run(`required:${a}:${x}|${b}:${y}`,layers,[...new Set([a,b].filter(k=>['GUARANTEE_PRESERVATION','CONTINUITY','DOMAIN_ADAPTERS'].includes(k)))]);\n+ }\n+}\n+for(const semantic of ['VERIFIED','REFUTED','UNVERIFIABLE',null])for(const support of [true,false])for(const native of vocabulary.RECOMPUTATION){const l=clone(baseline);l.RECOMPUTATION.status=native;l.RECOMPUTATION.semanticOutcome=semantic;run(`native:${native}|semantic:${semantic}|supported:${support}`,l,[],support);}\n+for(const nested of ['VERIFIED','CONTRADICTED','INSUFFICIENT_EVIDENCE','CANNOT_RECOMPUTE','REJECTED_MALFORMED','UNSUPPORTED_PROFILE'])for(const outer of vocabulary.GUARANTEE_PRESERVATION)for(const required of [[],['GUARANTEE_PRESERVATION']]){const l=clone(baseline);l.GUARANTEE_PRESERVATION.status=outer;l.GUARANTEE_PRESERVATION.productProjection={status:nested,reasonCodes:['AUDIT_NESTED_RESULT']};run(`prf:${outer}|nested:${nested}|required:${required.length}`,l,required);}\n+const malformed=[\n+ ['missing-layer',l=>delete l.AUTHENTICITY],['extra-layer',l=>l.EXTRA={status:'VERIFIED',reasonCodes:[],nativeResult:null}],\n+ ['truthy-status',l=>l.SEMANTIC_COMPATIBILITY.status=true],['false-native-outcome',l=>l.RECOMPUTATION.semanticOutcome=false],\n+ ['truthy-native-outcome',l=>l.RECOMPUTATION.semanticOutcome={}