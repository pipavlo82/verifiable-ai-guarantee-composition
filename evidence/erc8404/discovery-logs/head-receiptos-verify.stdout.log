t.json\",\n+      \"raw_blob\": \"0c6d2f8ae914eca988b7b020c1869bcd434edab0\",\n+      \"reachable_in_curated_history\": false\n+    },\n+    {\n+      \"original_commit\": \"3df769c4d873d6f354d1627a97967eec645bd727\",\n+      \"path\": \"reports/release-audit-v0.2/corpus/public-source-observations.json\",\n+      \"raw_blob\": \"65c3b8be0107fcdaf4063b3f3594f40cf9440427\",\n+      \"reachable_in_curated_history\": false\n+    },\n+    {\n+      \"original_commit\": \"1ddfc74c3b0d99b003b4fbe30a2ccb29ce13b417\",\n+      \"path\": \"reports/release-audit-v0.2/corpus/attribution-audit.json\",\n+      \"raw_blob\": \"8915f368570d80e61f785945a28ebc3717b31dce\",\n+      \"reachable_in_curated_history\": false\n+    },\n+    {\n+      \"original_commit\": \"1ddfc74c3b0d99b003b4fbe30a2ccb29ce13b417\",\n+      \"path\": \"reports/release-audit-v0.2/corpus/historical-ledger-audit.json\",\n+      \"raw_blob\": \"0c6d2f8ae914eca988b7b020c1869bcd434edab0\",\n+      \"reachable_in_curated_history\": false\n+    },\n+    {\n+      \"original_commit\": \"1ddfc74c3b0d99b003b4fbe30a2ccb29ce13b417\",\n+      \"path\": \"reports/release-audit-v0.2/corpus/public-source-observations.json\",\n+      \"raw_blob\": \"65c3b8be0107fcdaf4063b3f3594f40cf9440427\",\n+      \"reachable_in_curated_history\": false\n+    }\n+  ]\n+}"},{"sha":"95c09930d51e644d6be7e12c627042cad5d0063d","filename":"reports/release-audit-v0.2/capture-license/sanitize-captures.py","status":"added","additions":77,"deletions":0,"changes":77,"blob_url":"https://github.com/pipavlo82/receiptos-verify/blob/396143120f787d2f5534e92c0cf896c029a05775/reports%2Frelease-audit-v0.2%2Fcapture-license%2Fsanitize-captures.py","raw_url":"https://github.com/pipavlo82/receiptos-verify/raw/396143120f787d2f5534e92c0cf896c029a05775/reports%2Frelease-audit-v0.2%2Fcapture-license%2Fsanitize-captures.py","contents_url":"https://api.github.com/repos/pipavlo82/receiptos-verify/contents/reports%2Frelease-audit-v0.2%2Fcapture-license%2Fsanitize-captures.py?ref=396143120f787d2f5534e92c0cf896c029a05775","patch":"@@ -0,0 +1,77 @@\n+\"\"\"Inventory or sanitize only new audit JSON captures; never touch verifier code.\n+\n+Default is dry-run. --apply requires an explicit checkout directory and changes\n+only reports/release-audit-v0.2 files. Frozen pre-audit artifacts are outside scope.\n+The original raw evidence must be preserved separately before applying.\n+\"\"\"\n+import argparse,base64,collections,hashlib,json,pathlib,re\n+\n+BASE=pathlib.Path(__file__).resolve().parent.parent\n+def h(b):return hashlib.sha256(b).hexdigest()\n+def desc(value,encoding=None):\n+    raw=value.encode('utf-8') if isinstance(value,str) else json.dumps(value,sort_keys=True,ensure_ascii=False,separators=(',',':')).encode('utf-8')\n+    d={'valueType':type(value).__name__,'utf8Bytes':len(raw),'sha256':h(raw),'reason':'Unnecessary source/body capture omitted; metadata and original raw local evidence retained separately.'}\n+    if encoding=='base64' and isinstance(value,str):\n+        try:\n+            decoded=base64.b64decode(value,validate=False);d.update(decodedBytes=len(decoded),decodedSHA256=h(decoded))\n+        except Exception:d['decoding']='INVALID_BASE64'\n+    return d\n+def endpoint_repo(path,endpoint):\n+    for v in [endpoint,*path]:\n+        m=re.match(r'^repos/([^/]+/[^/]+)(?:/|$)',str(v))\n+        if m:return m[1]\n+    return None\n+def walk(value,path=(),api=False,endpoint=None,records=None):\n+    records=[] if records is None else records\n+    if isinstance(value,list):\n+        return [walk(v,(*path,str(i)),api,endpoint,records) for i,v in enumerate(value)]\n+    if not isinstance(value,dict):return value\n+    ownendpoint=value.get('endpoint');api=api or isinstance(ownendpoint,str) and ownendpoint.startswith('repos/')\n+    endpoint=ownendpoint if isinstance(ownendpoint,str) and ownendpoint.startswith('repos/') else endpoint\n+    result={}\n+    for key,val in value.items():\n+        child_api=api or key.startswith('repos/')\n+        child_endpoint=key if key.startswith('repos/') else endpoint\n+        # Numeric counters named \"patch\" are metadata, not source captures.\n+        omit=key=='patch' and isinstance(val,str) or key in ['content','body'] and api\n+        if omit:\n+            metadata=desc(val,value.get('encoding') if key=='content' else None)\n+            record={'jsonPath':'/'.join((*path,key)),'key':key,'repository':endpoint_repo(path,endpoint),'endpoint':endpoint,**metadata}\n+            records.append(record)\n+            replacement='_omitted_'+key\n+            if replacement in value:raise ValueError('Sanitizer replacement collision:'+replacement)\n+            result[replacement]=metadata\n+        else:result[key]=walk(val,(*path,key),child_api,child_endpoint,records)\n+    return result\n+def inventory(repo,apply=False):\n+    audit=repo/'reports/release-audit-v0.2';files=[];allrecords=[];bodycontent=[]\n+    for path in sorted(audit.rglob('*')):\n+        if not path.is_file() or path.suffix.lower() not in ['.json','.stdout','.txt']:continue\n+        raw=path.read_bytes()\n+        try:data=json.loads(raw)\n+        except (ValueError,UnicodeError):continue\n+        records=[];sanitized=walk(data,records=records)\n+        # Independently inspect preserved semantic body/content fields; these are\n+        # required request/signed-manifest/corpus witnesses, not API source captures.\n+        def inspect(v,p=()):\n+            if isinstance(v,dict):\n+                for k,x in v.items():\n+                    if k in ['body','content']:\n+                        bodycontent.append({'file':path.relative_to(repo).as_posix(),'jsonPath':'/'.join((*p,k)),**desc(x),'disposition':'PRESERVE_SEMANTIC_ORACLE_INPUT; not an API-context capture'})\n+                    inspect(x,(*p,k))\n+            elif isinstance(v,list):\n+                for i,x in enumerate(v):inspect(x,(*p,str(i)))\n+        inspect(sanitized)\n+        if not records:continue\n+        after=(json.dumps(sanitized,indent=2,ensure_ascii=False)+'\\n').encode('utf-8')\n+        rel=path.relative_to(repo).as_posix()\n+        for r in records:r['file']=rel\n+        allrecords+=records\n+        files.append({'path':rel,'beforeBytes':len(raw),'beforeSHA256':h(raw),'afterBytes':len(after),'afterSHA256':h(after),'omittedFields':len(records)})\n+        if apply:path.write_bytes(after)\n+    return {'schema':'receiptos.audit.capture-sanitization.v1','mode':'APPLIED' if apply else 'DRY_RUN','files':files,'omittedFieldCounts':dict(collections.Counter(r['key'] for r in allrecords)),'omittedFields':allrecords,'retainedSemanticBodyContent':bodycontent,'boundary':'Source/vendor/old vectors/legal/dependency files are untouched. This cleans current tree only; old local audit history must be quarantined or sanitized separately before any publication.'}\n+if __name__=='__main__':\n+    ap=argparse.ArgumentParser();ap.add_argument('--repo',type=pathlib.Path,default=BASE/'outputs/receiptos-verify');ap.add_argument('--out',type=pathlib.Path,default=BASE/'work/audit02-audit-capture-license-before.json');ap.add_argument('--apply',action='store_true');args=ap.parse_args()\n+    repo=args.repo.resolve(); assert repo.name.startswith('receiptos-verify') or 'audit' in repo.name or repo.name.startswith('ra'), 'Unexpected checkout root; pass an explicit intended audit checkout.'\n+    output=inventory(repo,args.apply);args.out.parent.mkdir(parents=True,exist_ok=True);args.out.write_text(json.dumps(output,indent=2,ensure_ascii=False)+'\\n',encoding='utf-8',newline='\\n')\n+    print(json.dumps({'mode':output['mode'],'files':len(output['files']),'omittedFieldCounts':output['omittedFieldCounts'],'semanticBodyContentRetained':len(output['retainedSemanticBodyContent']),'report':str(args.out)}))"},{"sha":"0ae12028ff8cae3583b721671ee386a310928939","filename":"reports/release-audit-v0.2/checkpoint.json","status":"added","additions":6,"deletions":0,"changes":6,"blob_url":"https://github.com/pipavlo82/receiptos-verify/blob/396143120f787d2f5534e92c0cf896c029a05775/reports%2Frelease-audit-v0.2%2Fcheckpoint.json","raw_url":"https://github.com/pipavlo82/receiptos-verify/raw/396143120f787d2f5534e92c0cf896c029a05775/reports%2Frelease-audit-v0.2%2Fcheckpoint.json","contents_url":"https://api.github.com/repos/pipavlo82/receiptos-verify/contents/reports%2Frelease-audit-v0.2%2Fcheckpoint.json?ref=396143120f787d2f5534e92c0cf896c029a05775","patch":"@@ -0,0 +1,6 @@\n+{\n+  \"candidate\": \"4888a0584369a91075eb2bdbd9a2ff6b99c46588\",\n+  \"captured_utc\": \"2026-10-11T23:13:41.683475+00:00\",\n+  \"implementation_changed\": false,\n+  \"frozen_verdict\": \"NEEDS_TECHNICAL_FIXES\"\n+}"},{"sha":"28c8c64c0f54fe215a6317a259f6879c4cef6e89","filename":"reports/release-audit-v0.2/closure-controller.py","status":"added","additions":42,"deletions":0,"changes":42,"blob_url":"https://github.com/pipavlo82/receiptos-verify/blob/396143120f787d2f5534e92c0cf896c029a05775/reports%2Frelease-audit-v0.2%2Fclosure-controller.py","raw_url":"https://github.com/pipavlo82/receiptos-verify/raw/396143120f787d2f5534e92c0cf896c029a05775/reports%2Frelease-audit-v0.2%2Fclosure-controller.py","contents_url":"https://api.github.com/repos/pipavlo82/receiptos-verify/contents/reports%2Frelease-audit-v0.2%2Fclosure-controller.py?ref=396143120f787d2f5534e92c0cf896c029a05775","patch":"@@ -0,0 +1,42 @@\n+import pathlib,subprocess,json,hashlib,datetime\n+ws=pathlib.Path(__file__).resolve().parent.parent;repo=ws/'outputs/receiptos-verify';audit=repo/'reports/release-audit-v0.2';frozen='4888a0584369a91075eb2bdbd9a2ff6b99c46588';tested='eb942148eeb489db809b39e053ec905105cc3056'\n+def h(b):return hashlib.sha256(b).hexdigest()\n+def git(*args,input=None):return subprocess.check_output(['git',*args],cwd=repo,input=input)\n+assert git('rev-parse','HEAD').decode().strip()==tested\n+checks={}\n+for name,folder,commit in [('frozen',audit/'freeze',frozen),('repaired',audit/'repair/final',tested)]:\n+ rows=json.loads((folder/('fresh-tracked-files.json' if name=='frozen' else 'tracked-files.json')).read_bytes());ids=[x['git_blob'] for x in rows]\n+ raw=git('cat-file','--batch',input=('\\n'.join(ids)+'\\n').encode());offset=0\n+ for row in rows:\n+  end=raw.index(b'\\n',offset);oid,kind,length=raw[offset:end].split();length=int(length);data=raw[end+1:end+1+length];offset=end+2+length\n+  assert kind==b'blob' and oid.decode()==row['git_blob'] and len(data)==row['bytes'] and h(data)==row['sha256'],row['path']\n+ assert offset==len(raw);checks[name+'_inventory_blobs']=len(rows)\n+for name,folder in [('frozen',audit/'gate'),('final',audit/'repair/final'),('intermediate_failed',audit/'repair/fresh')]:\n+ s=json.loads((folder/'summary.json').read_bytes());count=0\n+ for command in s['commands']:\n+  for suffix,key in [('stdout','stdout_sha256'),('stderr','stderr_sha256')]:\n+   p=folder/(command['label']+'.'+suffix);assert p.exists(),str(p);assert h(p.read_bytes())==command[key],str(p);count+=1\n+ checks[name+'_command_stream_hashes']=count\n+ for receiptpath in folder.glob('*-tests.json'):\n+  r=json.loads(receiptpath.read_bytes());stem=receiptpath.name[:-5]\n+  for ext,key in [('.stdout.txt','stdout_sha256'),('.stderr.txt','stderr_sha256')]:assert h((folder/(stem+ext)).read_bytes())==r[key]\n+final=json.loads((audit/'repair/final/summary.json').read_bytes());assert final['status']=='PASS';assert all(x['pass']==707 and x['fail']==0 for x in final['tests'].values());assert final['vectors']['passed']==68\n+allowed={'README.md','docs/files-not-reused.md','source-lock.json','RELEASE_AUDIT_v0.2.md'}\n+rows=json.loads((audit/'repair/final/tracked-files.json').read_bytes());runtime=[]\n+for row in rows:\n+ if row['path'].startswith('reports/') or row['path'] in allowed:continue\n+ assert h((repo/row['path']).read_bytes())==row['sha256'],row['path'];runtime.append(row['path'])\n+checks['tested_nonreport_files_unchanged']=len(runtime)\n+# Independently retain exact protected category counts.\n+entries=[x.split(b'\\t',1)[1].decode() for x in git('ls-tree','-r',frozen).splitlines()]\n+protected={}\n+for name,select in [('vectors',lambda x:x.startswith('vectors/')),('vendor',lambda x:x.startswith('vendor/')),('legal',lambda x:x in ['LICENSE','NOTICE','LICENSING.md','THIRD_PARTY_NOTICES.md']),('dependency',lambda x:x in ['package.json','package-lock.json','provenance/npm-licenses.json','third_party/npm-licenses.json'])]:\n+ selected=[x for x in entries if select(x)];bad=[x for x in selected if git('rev-parse',frozen+':'+x)!=git('rev-parse',tested+':'+x)];assert not bad;protected[name]={'files':len(selected),'changed':bad}\n+checks['protected']=protected\n+commands=[]\n+def run(label,argv):\n+ p=subprocess.run(argv,cwd=repo,capture_output=True);(audit/(label+'.stdout')).write_bytes(p.stdout);(audit/(label+'.stderr')).write_bytes(p.stderr);commands.append({'label':label,'argv':argv,'exit_code':p.returncode,'stdout_sha256':h(p.stdout),'stderr_sha256':h(p.stderr)});assert p.returncode==0,(argv,p.stderr.decode(errors='replace'));return p.stdout\n+run('closure-lock-write',['node','tools/check-sources.mjs','--write']);lockcheck=json.loads(run('closure-lock-check',['node','tools/check-sources.mjs']));run('closure-provenance-license',['node','tools/check-provenance-v2.mjs']);run('closure-diff-check',['git','diff','--check']);refs=run('closure-public-refs',['git','ls-remote','origin','refs/heads/main','refs/tags/v0.1.0','refs/tags/v0.1.0^{}']).decode();assert '62cd3e59c8f568496ed087d55f0aec3d63363b0a' in refs\n+out={'schema':'receiptos.verify.release-audit-closure.v2','tested_commit':tested,'tested_tree':final['tree'],'closure_boundary':'Only audit reports/evidence, README, corrected file-exclusion documentation and source-lock differ from tested tree; runtime/schema/tests/vendor/vector/dependency bytes match tested commit. Final child commit SHA is reported separately to avoid self-reference.','checks':checks,'final_source_lock':lockcheck,'package_lock_sha256':h((repo/'package-lock.json').read_bytes()),'commands':commands,'verdict':'READY_TO_PUBLISH_V0_2','timestamp_utc':datetime.datetime.now(datetime.timezone.utc).isoformat()}\n+(audit/'closure.json').write_text(json.dumps(out,indent=2)+'\\n',encoding='utf-8',newline='\\n')\n+print(json.dumps({'checks':checks,'source_lock':lockcheck,'verdict':out['verdict']}))"},{"sha":"e69de29bb2d1d6434b8b29ae775ad8c2e48c5391","filename":"reports/release-audit-v0.2/closure-diff-check.stderr","status":"added","additions":0,"deletions":0,"changes":0,"blob_url":"https://github.com/pipavlo82/receiptos-verify/blob/396143120f787d2f5534e92c0cf896c029a05775/reports%2Frelease-audit-v0.2%2Fclosure-diff-check.stderr","raw_url":"https://github.com/pipavlo82/receiptos-verify/raw/396143120f787d2f5534e92c0cf896c029a05775/reports%2Frelease-audit-v0.2%2Fclosure-diff-check.stderr","contents_url":"https://api.github.com/repos/pipavlo82/receiptos-verify/contents/reports%2Frelease-audit-v0.2%2Fclosure-diff-check.stderr?ref=396143120f787d2f5534e92c0cf896c029a05775"},{"sha":"e69de29bb2d1d6434b8b29ae775ad8c2e48c5391","filename":"reports/release-audit-v0.2/closure-diff-check.stdout","status":"added","additions":0,"deletions":0,"changes":0,"blob_url":"https://github.com/pipavlo82/receiptos-verify/blob/396143120f787d2f5534e92c0cf896c029a05775/reports%2Frelease-audit-v0.2%2Fclosure-diff-check.stdout","raw_url":"https://github.com/pipavlo82/receiptos-verify/raw/396143120f787d2f5534e92c0cf896c029a05775/reports%2Frelease-audit-v0.2%2Fclosure-diff-check.stdout","contents_url":"https://api.github.com/repos/pipavlo82/receiptos-verify/contents/reports%2Frelease-audit-v0.2%2Fclosure-diff-check.stdout?ref=396143120f787d2f5534e92c0cf896c029a05775"},{"sha":"e69de29bb2d1d6434b8b29ae775ad8c2e48c5391","filename":"reports/release-audit-v0.2/closure-lock-check.stderr","status":"added","additions":0,"deletions":0,"changes":0,"blob_url":"https://github.com/pipavlo82/receiptos-verify/blob/396143120f787d2f5534e92c0cf896c0