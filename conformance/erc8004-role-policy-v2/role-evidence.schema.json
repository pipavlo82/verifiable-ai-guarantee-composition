{
  "$id": "urn:veca:erc8004:role-evidence:v2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Structural admission only; policy additionally checks semantic bindings against actual local execution. Response evidence is a distinct field in the raw observation.",
  "properties": {
    "identity_registry_address": {
      "pattern": "^0x[0-9a-fA-F]{40}$",
      "type": "string"
    },
    "request_role_calls": {
      "additionalProperties": false,
      "properties": {
        "agent_id": {
          "minimum": 0,
          "type": "integer"
        },
        "block": {
          "additionalProperties": false,
          "properties": {
            "hash": {
              "pattern": "^0x[0-9a-fA-F]{64}$",
              "type": "string"
            },
            "number": {
              "pattern": "^0x[0-9a-fA-F]+$",
              "type": "string"
            }
          },
          "required": [
            "number",
            "hash"
          ],
          "type": "object"
        },
        "block_hash": {
          "pattern": "^0x[0-9a-fA-F]{64}$",
          "type": "string"
        },
        "block_number": {
          "pattern": "^0x[0-9a-fA-F]+$",
          "type": "string"
        },
        "calls": {
          "additionalProperties": false,
          "properties": {
            "agent_wallet": {
              "additionalProperties": false,
              "properties": {
                "block_tag": {
                  "pattern": "^0x[0-9a-fA-F]+$",
                  "type": "string"
                },
                "data": {
                  "pattern": "^0x(?:[0-9a-fA-F]{2})+$",
                  "type": "string"
                },
                "result": {
                  "pattern": "^0x[0-9a-fA-F]{64}$",
                  "type": "string"
                },
                "to": {
                  "pattern": "^0x[0-9a-fA-F]{40}$",
                  "type": "string"
                }
              },
              "required": [
                "to",
                "data",
                "block_tag",
                "result"
              ],
              "type": "object"
            },
            "approved": {
              "additionalProperties": false,
              "properties": {
                "block_tag": {
                  "pattern": "^0x[0-9a-fA-F]+$",
                  "type": "string"
                },
                "data": {
                  "pattern": "^0x(?:[0-9a-fA-F]{2})+$",
                  "type": "string"
                },
                "result": {
                  "pattern": "^0x[0-9a-fA-F]{64}$",
                  "type": "string"
                },
                "to": {
                  "pattern": "^0x[0-9a-fA-F]{40}$",
                  "type": "string"
                }
              },
              "required": [
                "to",
                "data",
                "block_tag",
                "result"
              ],
              "type": "object"
            },
            "operator": {
              "additionalProperties": false,
              "properties": {
                "block_tag": {
                  "pattern": "^0x[0-9a-fA-F]+$",
                  "type": "string"
                },
                "data": {
                  "pattern": "^0x(?:[0-9a-fA-F]{2})+$",
                  "type": "string"
                },
                "result": {
                  "pattern": "^0x[0-9a-fA-F]{64}$",
                  "type": "string"
                },
                "to": {
                  "pattern": "^0x[0-9a-fA-F]{40}$",
                  "type": "string"
                }
              },
              "required": [
                "to",
                "data",
                "block_tag",
                "result"
              ],
              "type": "object"
            },
            "owner": {
              "additionalProperties": false,
              "properties": {
                "block_tag": {
                  "pattern": "^0x[0-9a-fA-F]+$",
                  "type": "string"
                },
                "data": {
                  "pattern": "^0x(?:[0-9a-fA-F]{2})+$",
                  "type": "string"
                },
                "result": {
                  "pattern": "^0x[0-9a-fA-F]{64}$",
                  "type": "string"
                },
                "to": {
                  "pattern": "^0x[0-9a-fA-F]{40}$",
                  "type": "string"
                }
              },
              "required": [
                "to",
                "data",
                "block_tag",
                "result"
              ],
              "type": "object"
            }
          },
          "required": [
            "owner",
            "operator",
            "approved",
            "agent_wallet"
          ],
          "type": "object"
        },
        "capture": {
          "const": "LOCAL_EVM_ETH_CALL_AT_RECEIPT_BLOCK"
        },
        "chain_id": {
          "minimum": 0,
          "type": "integer"
        },
        "registry": {
          "pattern": "^0x[0-9a-fA-F]{40}$",
          "type": "string"
        },
        "request_hash": {
          "pattern": "^0x[0-9a-fA-F]{64}$",
          "type": "string"
        },
        "schema": {
          "const": "erc8004.request-role-calls.v2"
        },
        "validator": {
          "pattern": "^0x[0-9a-fA-F]{40}$",
          "type": "string"
        }
      },
      "required": [
        "agent_id",
        "validator",
        "request_hash",
        "block_number",
        "block_hash",
        "schema",
        "capture",
        "registry",
        "chain_id",
        "block",
        "calls"
      ],
      "type": "object"
    },
    "request_roles": {
      "additionalProperties": false,
      "properties": {
        "agent_id": {
          "minimum": 0,
          "type": "integer"
        },
        "agent_wallet": {
          "pattern": "^0x[0-9a-fA-F]{40}$",
          "type": "string"
        },
        "approved": {
          "pattern": "^0x[0-9a-fA-F]{40}$",
          "type": "string"
        },
        "block_hash": {
          "pattern": "^0x[0-9a-fA-F]{64}$",
          "type": "string"
        },
        "block_number": {
          "pattern": "^0x[0-9a-fA-F]+$",
          "type": "string"
        },
        "operator": {
          "type": "boolean"
        },
        "owner": {
          "pattern": "^0x[0-9a-fA-F]{40}$",
          "type": "string"
        },
        "request_hash": {
          "pattern": "^0x[0-9a-fA-F]{64}$",
          "type": "string"
        },
        "validator": {
          "pattern": "^0x[0-9a-fA-F]{40}$",
          "type": "string"
        }
      },
      "required": [
        "agent_id",
        "validator",
        "request_hash",
        "block_number",
        "block_hash",
        "owner",
        "operator",
        "approved",
        "agent_wallet"
      ],
      "type": "object"
    }
  },
  "required": [
    "identity_registry_address",
    "request_roles",
    "request_role_calls"
  ],
  "title": "Admitted local request-block role evidence v2",
  "type": "object"
}
